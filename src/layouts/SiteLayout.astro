---
import "../styles/global.css";
import "../styles/rebuild.css";
import "../styles/portal.css";
const {
  title = "Nexauren Story — Free Online Tools & Technology",
  description = "Explore free online tools for images, PDF, text and audio, plus practical technology guides.",
  noIndex = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://nexaurenstory.com").toString();
const robots = noIndex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": "https://nexaurenstory.com/#organization", "name": "Nexauren Story", "url": "https://nexaurenstory.com/", "logo": "https://nexaurenstory.com/favicon.svg" },
    { "@type": "WebSite", "@id": "https://nexaurenstory.com/#website", "name": "Nexauren Story", "url": "https://nexaurenstory.com/", "inLanguage": ["en", "pt"], "publisher": { "@id": "https://nexaurenstory.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": "https://nexaurenstory.com/tools?q={search_term_string}", "query-input": "required name=search_term_string" } }
  ]
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2381605116846917" crossorigin="anonymous"></script>
  <meta name="theme-color" content="#050b1c" />
  <meta name="color-scheme" content="dark light" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <meta name="author" content="Nexauren Story" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <meta name="apple-mobile-web-app-title" content="Nexauren Story" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nexauren Story" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="pt_PT" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://nexaurenstory.com/og-cover.svg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nexaurenstory.com/og-cover.svg" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script is:inline>
    (() => {
      try {
        const savedTheme = localStorage.getItem("nexauren:theme") || "dark";
        document.documentElement.dataset.theme = savedTheme === "light" ? "light" : "dark";
      } catch {}
    })();
  </script>
</head>
<body>
  <div class="site-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="navigation-progress" data-navigation-progress></div>
  <slot />
  <script is:inline>
  (() => {
    const supported = ["en", "pt"];
    const dictionaryCache = new Map();
    const textStates = new WeakMap();
    const attributeStates = new WeakMap();
    let current = "en";
    let dictionary = {};

    function translateSingle(source) {
      if (!source) return source;
      const clean = source.trim();
      if (!clean) return source;
      if (Object.prototype.hasOwnProperty.call(dictionary, clean)) {
        return source.replace(clean, dictionary[clean]);
      }

      const patterns = [
        [/^(\d+)\s+ferramentas?$/i, n => n + " tools"],
        [/^(\d+)\s+categorias?$/i, n => n + " categories"],
        [/^(\d+)\s+ferramentas disponíveis$/i, n => n + " available tools"],
        [/^(\d+)\s+ferramenta disponível$/i, n => n + " available tool"],
        [/^(\d+)\s+documentos?$/i, n => n + " documents"],
        [/^(\d+)\s+páginas?$/i, n => n + " pages"],
        [/^(\d+)\s+caracteres?$/i, n => n + " characters"],
        [/^(\d+)\s+palavras?$/i, n => n + " words"],
        [/^(\d+)\s+linhas?$/i, n => n + " lines"],
        [/^(\d+)\s+minutos?$/i, n => n + " minutes"],
        [/^(\d+)\s+documentos?\s+·\s+(\d+)\s+páginas?\s+·\s+(.+)$/i, (docs, pages, size) => docs + " documents · " + pages + " pages · " + size],
        [/^Combinar\s+(\d+)\s+PDFs$/i, n => "Merge " + n + " PDFs"],
        [/^Extrair\s+(\d+)\s+página\(s\)$/i, n => "Extract " + n + " page(s)"],
        [/^(\d+)\s+página\(s\) extraída\(s\) com sucesso\.$/i, n => n + " page(s) extracted successfully."],
        [/^Documento criado com (\d+) páginas, pela ordem escolhida\.$/i, n => "Document created with " + n + " pages, in the selected order."],
        [/^(\d+) documento\(s\) adicionado\(s\)\. Podes alterar a ordem antes de combinar\.$/i, n => n + " document(s) added. You can change the order before merging."],
        [/^A extrair (\d+) página\(s\)…$/i, n => "Extracting " + n + " page(s)…"],
        [/^A aplicar rotação a (\d+) página\(s\)…$/i, n => "Applying rotation to " + n + " page(s)…"],
        [/^Orientação actualizada em (\d+) página\(s\)\.$/i, n => "Orientation updated on " + n + " page(s)."],
        [/^A rotação será aplicada a todas as (\d+) páginas\.$/i, n => "Rotation will be applied to all " + n + " pages."],
        [/^Indica um número de página entre 1 e (\d+)\.$/i, n => "Enter a page number between 1 and " + n + "."],
        [/^O intervalo deve estar entre 1 e (\d+)\.$/i, n => "The range must be between 1 and " + n + "."],
        [/^Análise concluída\. Foram encontradas (\d+) páginas\.$/i, n => "Analysis complete. " + n + " pages found."],
        [/^Processamento concluído\. (\d+) páginas no ficheiro final\.$/i, n => "Processing complete. " + n + " pages in the final file."],
        [/^PDF combinado com (\d+) páginas\.$/i, n => "PDF merged with " + n + " pages."],
        [/^Imagem processada: (.+)$/i, value => "Image processed: " + value],
        [/^Recorte criado\. (.+), pronto para descarregar\.$/i, value => "Crop created. " + value + ", ready to download."],
        [/^A importar (.+)…$/i, value => "Importing " + value + "…"],
        [/^A otimizar (.+)…$/i, value => "Optimising " + value + "…"],
        [/^Não foi possível ler este PDF\. (.+)$/i, value => "Unable to read this PDF. " + value],
        [/^Não foi possível abrir um dos PDFs\. (.+)$/i, value => "Unable to open one of the PDFs. " + value],
        [/^Não foi possível descodificar este áudio\. (.+)$/i, value => "Unable to decode this audio. " + value],
        [/^Não foi possível otimizar o PDF\. (.+)$/i, value => "Unable to optimise the PDF. " + value],
        [/^Original: (.+)$/i, value => "Original: " + value],
        [/^Novo: (.+)$/i, value => "New: " + value],
        [/^Tamanho: (.+)$/i, value => "Size: " + value],
        [/^Nome: (.+)$/i, value => "Name: " + value],
        [/^Formato: (.+)$/i, value => "Format: " + value],
        [/^Dimensões: (.+)$/i, value => "Dimensions: " + value],
        [/^Título: (.+)$/i, value => "Title: " + value],
        [/^Autor: (.+)$/i, value => "Author: " + value],
        [/^Canais: (.+)$/i, value => "Channels: " + value],
        [/^Frequência: (.+)$/i, value => "Sample rate: " + value],
        [/^Duração: (.+)$/i, value => "Duration: " + value],
        [/^Duração final: (.+)$/i, value => "Final duration: " + value],
        [/^Dias: (.+)$/i, value => "Days: " + value],
        [/^Anos completos: (.+)$/i, value => "Full years: " + value],
        [/^Semana ISO: (.+)$/i, value => "ISO week: " + value],
        [/^Rácio de contraste: (.+)$/i, value => "Contrast ratio: " + value],
        [/^Média: (.+)$/i, value => "Average: " + value],
        [/^Preço final: (.+)$/i, value => "Final price: " + value],
        [/^A importar (.+)…$/i, value => "Importing " + value + "…"],
        [/^A preparar (.+)…$/i, value => "Preparing " + value + "…"],
        [/^A analisar (.+)…$/i, value => "Analysing " + value + "…"],
        [/^PALAVRAS\s+(.+)$/i, value => "WORDS  " + value],
        [/^CARACTERES\s+(.+)$/i, value => "CHARACTERS  " + value],
        [/^SEM ESPAÇOS\s+(.+)$/i, value => "NO SPACES  " + value],
        [/^LINHAS\s+(.+)$/i, value => "LINES  " + value],
        [/^PARÁGRAFOS\s+(.+)$/i, value => "PARAGRAPHS  " + value],
        [/^Caracteres:\s*(.+)$/i, value => "Characters: " + value],
        [/^Sem espaços:\s*(.+)$/i, value => "Without spaces: " + value],
        [/^Bytes UTF-8:\s*(.+)$/i, value => "UTF-8 bytes: " + value],
        [/^Linha (\d+): (\d+) colunas$/i, (line, columns) => "Row " + line + ": " + columns + " columns"],
        [/^CSV válido: (\d+) linhas e (\d+) colunas\.$/i, (rows, columns) => "Valid CSV: " + rows + " rows and " + columns + " columns."],
        [/^Encontradas (\d+) linha\(s\) com número de colunas diferente de (\d+):$/i, (rows, columns) => "Found " + rows + " row(s) with a different number of columns than " + columns + ":"],
        [/^(\d+) substituição\(ões\) preparada\(s\)\.$/i, n => n + " replacement(s) ready."],
        [/^Otimização concluída\. Os ficheiros ficaram (\d+)% mais pequenos no total\.$/i, n => "Optimisation complete. The files are " + n + "% smaller overall."],
        [/^A rotação será aplicada a todas as (\d+) páginas\.$/i, n => "Rotation will be applied to all " + n + " pages."]
      ];

      for (const [pattern, render] of patterns) {
        const match = clean.match(pattern);
        if (match) return source.replace(clean, render(...match.slice(1)));
      }
      return source;
    }

    function translateValue(source) {
      if (current !== "en" || !source) return source;
      return source.split("\n").map(line => translateSingle(line)).join("\n");
    }
    function translateTextNode(node) {
      if (!node || !node.nodeValue || !node.nodeValue.trim()) return;
      const parent = node.parentElement;
      if (parent && parent.closest("script,style,noscript,code,textarea,[translate=\"no\"])) return;
      if (parent && parent.closest("pre") && !parent.closest("[data-translate-content]")) return;
      let state = textStates.get(node);
      if (!state) {
        state = { original: node.nodeValue, last: null };
        textStates.set(node, state);
      } else if (node.nodeValue !== state.last) {
        state.original = node.nodeValue;
      }
      const next = translateValue(state.original);
      state.last = next;
      if (node.nodeValue !== next) node.nodeValue = next;
    }

    const translatableAttributes = ["placeholder", "aria-label", "aria-description", "title", "alt"];
    function translateAttributes(root) {
      const elements = [];
      if (root.nodeType === 1) elements.push(root);
      if (root.querySelectorAll) elements.push(...root.querySelectorAll("[placeholder],[aria-label],[aria-description],[title],[alt]"));
      for (const element of elements) {
        let state = attributeStates.get(element);
        if (!state) { state = {}; attributeStates.set(element, state); }
        for (const name of translatableAttributes) {
          if (!element.hasAttribute(name)) continue;
          const now = element.getAttribute(name);
          let item = state[name];
          if (!item) { item = { original: now, last: null }; state[name] = item; }
          else if (now !== item.last) item.original = now;
          const next = translateValue(item.original);
          item.last = next;
          if (now !== next) element.setAttribute(name, next);
        }
        if (element instanceof HTMLInputElement && ["button", "submit", "reset"].includes(element.type)) {
          const now = element.value;
          let item = state.value;
          if (!item) { item = { original: now, last: null }; state.value = item; }
          else if (now !== item.last) item.original = now;
          const next = translateValue(item.original);
          item.last = next;
          if (now !== next) element.value = next;
        }
      }
    }
    function translateTree(root) {
      if (!root) return;
      if (root.nodeType === 3) { translateTextNode(root); return; }
      if (root.querySelectorAll || root.nodeType === 1) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        let node;
        while ((node = walker.nextNode())) translateTextNode(node);
        translateAttributes(root);
      }
    }

    async function loadDictionary(locale) {
      if (dictionaryCache.has(locale)) return dictionaryCache.get(locale);
      if (locale !== "en") return {};
      const response = await fetch("/translations/en.json", { cache: "no-cache" });
      if (!response.ok) throw new Error("Translation file unavailable");
      const result = await response.json();
      dictionaryCache.set(locale, result);
      return result;
    }

    let languageRequestId = 0;
    async function setLanguage(locale) {
      const requestId = ++languageRequestId;
      const selected = supported.includes(locale) ? locale : "en";
      let nextDictionary = {};
      try { nextDictionary = await loadDictionary(selected); } catch { nextDictionary = {}; }
      if (requestId !== languageRequestId) return;
      dictionary = nextDictionary;
      current = selected;
      document.documentElement.lang = selected;
      const localeMeta = document.querySelector('meta[property="og:locale"]');
      if (localeMeta) localeMeta.setAttribute("content", selected === "en" ? "en_US" : "pt_PT");
      const alternate = document.querySelector('meta[property="og:locale:alternate"]');
      if (alternate) alternate.setAttribute("content", selected === "en" ? "pt_PT" : "en_US");
      try { localStorage.setItem("nexauren:portal-language", selected); } catch {}
      document.querySelectorAll("[data-language-select]").forEach(select => { select.value = selected; });
      const title = document.querySelector("title");
      if (title) {
        const original = title.dataset.original || title.textContent || "";
        title.dataset.original = original;
        document.title = translateValue(original);
      }
      translateTree(document.head);
      translateTree(document.body);
      for (const selector of ['meta[name="description"]','meta[property="og:title"]','meta[property="og:description"]','meta[name="twitter:title"]','meta[name="twitter:description"]']) {
        const meta = document.querySelector(selector);
        if (meta) {
          const original = meta.dataset.original || meta.getAttribute("content") || "";
          meta.dataset.original = original;
          meta.setAttribute("content", translateValue(original));
        }
      }
    }

    let savedLanguage = "en";
    try { savedLanguage = localStorage.getItem("nexauren:portal-language") || "en"; } catch {}
    void setLanguage(savedLanguage);

    let theme = document.documentElement.dataset.theme || "dark";
    function setTheme(value) {
      theme = value === "light" ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem("nexauren:theme", theme); } catch {}
      document.querySelectorAll("[data-theme-toggle]").forEach(button => {
        button.setAttribute("aria-label", theme === "dark" ? "Ativar modo claro" : "Ativar modo escuro");
        button.setAttribute("aria-pressed", String(theme === "dark"));
        const icon = button.querySelector("[data-theme-icon]");
        if (icon) icon.textContent = theme === "dark" ? "☼" : "☾";
      });
    }
    setTheme(theme);

    document.addEventListener("change", event => {
      const target = event.target;
      if (target && target.matches && target.matches("[data-language-select]")) void setLanguage(target.value);
    });


    const observer = new MutationObserver(records => {
      for (const record of records) {
        if (record.type === "characterData") translateTextNode(record.target);
        else if (record.type === "attributes") {
          if (["placeholder", "aria-label", "aria-description", "title", "alt"].includes(record.attributeName)) translateAttributes(record.target);
        } else {
          for (const node of record.addedNodes) translateTree(node);
          if (record.target.nodeType === 1) translateAttributes(record.target);
        }
      }
    });
    observer.observe(document.body, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ["placeholder", "aria-label", "aria-description", "title", "alt", "class"] });
    observer.observe(document.head, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ["content"] });
    let pendingDownload = null;
    let replayingDownload = false;
    let downloadDialog = null;

    function getDownloadDialog() {
      if (downloadDialog) return downloadDialog;
      const dialog = document.createElement("dialog");
      dialog.className = "nexa-download-dialog";
      dialog.setAttribute("aria-labelledby", "nexa-download-title");
      dialog.setAttribute("aria-describedby", "nexa-download-description");
      const panel = document.createElement("div");
      panel.className = "nexa-download-dialog-panel";
      const top = document.createElement("div");
      top.className = "nexa-download-dialog-top";
      const mark = document.createElement("span");
      mark.className = "nexa-download-dialog-mark";
      mark.textContent = "N";
      const close = document.createElement("button");
      close.type = "button";
      close.className = "nexa-download-dialog-close";
      close.setAttribute("aria-label", "Fechar");
      close.textContent = "×";
      close.addEventListener("click", () => { pendingDownload = null; dialog.close(); });
      top.append(mark, close);
      const title = document.createElement("h2");
      title.id = "nexa-download-title";
      title.textContent = "Apoia a Nexauren Story";
      const description = document.createElement("p");
      description.id = "nexa-download-description";
      description.textContent = "Antes de descarregar, acompanha as novidades e novas ferramentas nos nossos canais.";
      const socials = document.createElement("div");
      socials.className = "nexa-download-socials";
      for (const item of [
        { label: "YouTube", href: "https://www.youtube.com/@Nexauren", icon: "▶" },
        { label: "Bluesky", href: "https://bsky.app/profile/nexauren.bsky.social", icon: "✳" },
        { label: "Facebook", href: "https://www.facebook.com/nexaurentech", icon: "f" }
      ]) {
        const link = document.createElement("a");
        link.href = item.href;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "nexa-download-social-link";
        const icon = document.createElement("span");
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = item.icon;
        const label = document.createElement("span");
        label.textContent = item.label;
        link.append(icon, label);
        socials.append(link);
      }
      const actions = document.createElement("div");
      actions.className = "nexa-download-dialog-actions";
      const cancel = document.createElement("button");
      cancel.type = "button";
      cancel.className = "nexa-download-cancel";
      cancel.textContent = "Agora não";
      cancel.addEventListener("click", () => { pendingDownload = null; dialog.close(); });
      const proceed = document.createElement("button");
      proceed.type = "button";
      proceed.className = "nexa-download-continue";
      proceed.textContent = "Continuar para o download";
      proceed.addEventListener("click", continuePendingDownload);
      actions.append(cancel, proceed);
      panel.append(top, title, description, socials, actions);
      dialog.append(panel);
      dialog.addEventListener("click", event => {
        if (event.target === dialog) { pendingDownload = null; dialog.close(); }
      });
      document.body.append(dialog);
      translateTree(dialog);
      downloadDialog = dialog;
      return dialog;
    }

    function openDownloadDialog(action) {
      pendingDownload = action;
      const dialog = getDownloadDialog();
      if (!dialog.open) dialog.showModal();
      const proceed = dialog.querySelector(".nexa-download-continue");
      proceed?.focus();
    }

    function continuePendingDownload() {
      const action = pendingDownload;
      pendingDownload = null;
      if (downloadDialog?.open) downloadDialog.close();
      if (!action) return;

      replayingDownload = true;
      try {
        if (action.type === "anchor") {
          const link = document.createElement("a");
          link.href = action.href;
          link.download = action.filename;
          link.style.display = "none";
          document.body.append(link);
          link.click();
          link.remove();
        } else if (action.element?.isConnected) {
          action.element.click();
        }
      } finally {
        replayingDownload = false;
      }
    }

    document.addEventListener("click", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (!replayingDownload && event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
        const anchor = target.closest("a[download]");
        const trigger = target.closest("[data-nexa-download-trigger]");
        if (anchor || trigger) {
          event.preventDefault();
          event.stopPropagation();
          if (anchor) {
            openDownloadDialog({
              type: "anchor",
              href: anchor.href,
              filename: anchor.getAttribute("download") || ""
            });
          } else {
            openDownloadDialog({ type: "trigger", element: trigger });
          }
          return;
        }
      }

      const themeToggle = target.closest("[data-theme-toggle]");
      if (themeToggle) { setTheme(theme === "dark" ? "light" : "dark"); return; }
      const menuToggle = target.closest("[data-menu-toggle]");
      if (menuToggle) {
        const menu = document.querySelector("[data-mobile-menu]");
        const open = menu?.classList.toggle("open") ?? false;
        menuToggle.setAttribute("aria-expanded", String(open));
      }
      if (target.closest("[data-mobile-menu] a")) {
        document.querySelector("[data-mobile-menu]")?.classList.remove("open");
        document.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", "false");
      }
      const link = target.closest("a[href]");
      if (link && link.origin === location.origin && !link.hash && !event.metaKey && !event.ctrlKey && !event.shiftKey) {
        document.querySelector("[data-navigation-progress]")?.classList.add("is-loading");
      }
    }, true);
    document.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        document.querySelector("[data-mobile-menu]")?.classList.remove("open");
        document.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", "false");
      }
    });
    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add("is-visible"); revealObserver.unobserve(entry.target); }
      }), { threshold: .08 });
      document.querySelectorAll(".ns-reveal").forEach(node => {
        node.classList.add("scroll-reveal");
        revealObserver.observe(node);
      });
    }
  })();
  </script>
</body>
</html>