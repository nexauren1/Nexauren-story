---
import "../styles/global.css";
import "../styles/rebuild.css";
import "../styles/portal.css";
const {
  title = "Nexauren Story — Free Online Tools & Technology",
  description = "Explore free online tools for images, PDF, text and audio, plus practical technology guides.",
  noIndex = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://nexaurenstory.com").toString();
const robots = noIndex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": "https://nexaurenstory.com/#organization", "name": "Nexauren Story", "url": "https://nexaurenstory.com/", "logo": "https://nexaurenstory.com/favicon.svg" },
    { "@type": "WebSite", "@id": "https://nexaurenstory.com/#website", "name": "Nexauren Story", "url": "https://nexaurenstory.com/", "inLanguage": ["en", "pt"], "publisher": { "@id": "https://nexaurenstory.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": "https://nexaurenstory.com/tools?q={search_term_string}", "query-input": "required name=search_term_string" } }
  ]
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#050b1c" />
  <meta name="color-scheme" content="dark light" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <meta name="author" content="Nexauren Story" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <meta name="apple-mobile-web-app-title" content="Nexauren Story" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nexauren Story" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="pt_PT" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://nexaurenstory.com/og-cover.svg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nexaurenstory.com/og-cover.svg" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script is:inline>
    (() => {
      try {
        const savedTheme = localStorage.getItem("nexauren:theme") || "dark";
        document.documentElement.dataset.theme = savedTheme === "light" ? "light" : "dark";
      } catch {}
    })();
  </script>
</head>
<body>
  <div class="site-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="navigation-progress" data-navigation-progress></div>
  <slot />
  <script is:inline>
  (() => {
    const supported = ["en", "pt"];
    const dictionaryCache = new Map();
    const textStates = new WeakMap();
    const attributeStates = new WeakMap();
    let current = "en";
    let dictionary = {};

    function translateValue(source) {
      if (current !== "en" || !source) return source;
      const clean = source.trim();
      if (Object.prototype.hasOwnProperty.call(dictionary, clean)) return source.replace(clean, dictionary[clean]);
      const patterns = [
        [/^(\d+)\s+ferramentas?$/i, n => n + " tools"],
        [/^(\d+)\s+categorias?$/i, n => n + " categories"],
        [/^(\d+)\s+ferramentas disponíveis$/i, n => n + " available tools"],
        [/^(\d+)\s+ferramenta disponível$/i, n => n + " available tool"],
        [/^(\d+)\s+documentos?$/i, n => n + " documents"],
        [/^(\d+)\s+páginas?$/i, n => n + " pages"],
        [/^(\d+)\s+caracteres?$/i, n => n + " characters"],
        [/^(\d+)\s+palavras?$/i, n => n + " words"],
        [/^(\d+)\s+linhas?$/i, n => n + " lines"],
        [/^(\d+)\s+minutos?$/i, n => n + " minutes"]
      ];
      for (const [pattern, render] of patterns) {
        const match = clean.match(pattern);
        if (match) return source.replace(clean, render(match[1]));
      }
      return source;
    }

    function translateTextNode(node) {
      if (!node || !node.nodeValue || !node.nodeValue.trim()) return;
      const parent = node.parentElement;
      if (parent && parent.closest("script,style,noscript,code,pre,textarea")) return;
      let state = textStates.get(node);
      if (!state) {
        state = { original: node.nodeValue, last: null };
        textStates.set(node, state);
      } else if (node.nodeValue !== state.last) {
        state.original = node.nodeValue;
      }
      const next = translateValue(state.original);
      state.last = next;
      if (node.nodeValue !== next) node.nodeValue = next;
    }

    function translateAttributes(root) {
      const elements = [];
      if (root.nodeType === 1) elements.push(root);
      if (root.querySelectorAll) elements.push(...root.querySelectorAll("[placeholder],[aria-label],[title]"));
      for (const element of elements) {
        let state = attributeStates.get(element);
        if (!state) {
          state = {};
          for (const name of ["placeholder", "aria-label", "title"]) {
            if (element.hasAttribute(name)) state[name] = { original: element.getAttribute(name), last: null };
          }
          attributeStates.set(element, state);
        }
        for (const name of ["placeholder", "aria-label", "title"]) {
          if (!element.hasAttribute(name)) continue;
          const now = element.getAttribute(name);
          let item = state[name];
          if (!item) { item = { original: now, last: null }; state[name] = item; }
          else if (now !== item.last) item.original = now;
          const next = translateValue(item.original);
          item.last = next;
          if (now !== next) element.setAttribute(name, next);
        }
      }
    }

    function translateTree(root) {
      if (!root) return;
      if (root.nodeType === 3) { translateTextNode(root); return; }
      if (root.querySelectorAll || root.nodeType === 1) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        let node;
        while ((node = walker.nextNode())) translateTextNode(node);
        translateAttributes(root);
      }
    }

    async function loadDictionary(locale) {
      if (dictionaryCache.has(locale)) return dictionaryCache.get(locale);
      if (locale !== "en") return {};
      const response = await fetch("/translations/en.json", { cache: "force-cache" });
      if (!response.ok) throw new Error("Translation file unavailable");
      const result = await response.json();
      dictionaryCache.set(locale, result);
      return result;
    }

    async function setLanguage(locale) {
      const selected = supported.includes(locale) ? locale : "en";
      try { dictionary = await loadDictionary(selected); } catch { dictionary = {}; }
      current = selected;
      document.documentElement.lang = selected;
      const localeMeta = document.querySelector('meta[property="og:locale"]');
      if (localeMeta) localeMeta.setAttribute("content", selected === "en" ? "en_US" : "pt_PT");
      const alternate = document.querySelector('meta[property="og:locale:alternate"]');
      if (alternate) alternate.setAttribute("content", selected === "en" ? "pt_PT" : "en_US");
      try { localStorage.setItem("nexauren:portal-language", selected); } catch {}
      document.querySelectorAll("[data-language-select]").forEach(select => { select.value = selected; });
      const title = document.querySelector("title");
      if (title) {
        const original = title.dataset.original || title.textContent || "";
        title.dataset.original = original;
        document.title = translateValue(original);
      }
      translateTree(document.head);
      translateTree(document.body);
      for (const selector of ['meta[name="description"]','meta[property="og:title"]','meta[property="og:description"]','meta[name="twitter:title"]','meta[name="twitter:description"]']) {
        const meta = document.querySelector(selector);
        if (meta) {
          const original = meta.dataset.original || meta.getAttribute("content") || "";
          meta.dataset.original = original;
          meta.setAttribute("content", translateValue(original));
        }
      }
    }

    let savedLanguage = "en";
    try { savedLanguage = localStorage.getItem("nexauren:portal-language") || "en"; } catch {}
    void setLanguage(savedLanguage);

    let theme = document.documentElement.dataset.theme || "dark";
    function setTheme(value) {
      theme = value === "light" ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem("nexauren:theme", theme); } catch {}
      document.querySelectorAll("[data-theme-toggle]").forEach(button => {
        button.setAttribute("aria-label", theme === "dark" ? "Ativar modo claro" : "Ativar modo escuro");
        button.setAttribute("aria-pressed", String(theme === "dark"));
        const icon = button.querySelector("[data-theme-icon]");
        if (icon) icon.textContent = theme === "dark" ? "☼" : "☾";
      });
    }
    setTheme(theme);

    document.addEventListener("change", event => {
      const target = event.target;
      if (target && target.matches && target.matches("[data-language-select]")) void setLanguage(target.value);
    });

    const observer = new MutationObserver(records => {
      for (const record of records) {
        if (record.type === "characterData") translateTextNode(record.target);
        else {
          for (const node of record.addedNodes) translateTree(node);
          if (record.target.nodeType === 1) translateAttributes(record.target);
        }
      }
    });
    observer.observe(document.body, { subtree: true, childList: true, characterData: true });
    observer.observe(document.head, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ["content"] });

    document.addEventListener("click", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const themeToggle = target.closest("[data-theme-toggle]");
      if (themeToggle) { setTheme(theme === "dark" ? "light" : "dark"); return; }
      const menuToggle = target.closest("[data-menu-toggle]");
      if (menuToggle) {
        const menu = document.querySelector("[data-mobile-menu]");
        const open = menu?.classList.toggle("open") ?? false;
        menuToggle.setAttribute("aria-expanded", String(open));
      }
      if (target.closest("[data-mobile-menu] a")) {
        document.querySelector("[data-mobile-menu]")?.classList.remove("open");
        document.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", "false");
      }
      const link = target.closest("a[href]");
      if (link && link.origin === location.origin && !link.hash && !event.metaKey && !event.ctrlKey && !event.shiftKey) {
        document.querySelector("[data-navigation-progress]")?.classList.add("is-loading");
      }
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        document.querySelector("[data-mobile-menu]")?.classList.remove("open");
        document.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", "false");
      }
    });
    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add("is-visible"); revealObserver.unobserve(entry.target); }
      }), { threshold: .08 });
      document.querySelectorAll(".ns-reveal").forEach(node => {
        node.classList.add("scroll-reveal");
        revealObserver.observe(node);
      });
    }
  })();
  </script>
</body>
</html>