---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FavoriteButton from "../components/FavoriteButton";
import TrackedLink from "../components/TrackedLink";
---
<SiteLayout title="Apps Android da Nexauren | Image Tools, PDF Max e mais" description="Descobre as aplicações Android da Nexauren, consulta funcionalidades e visita as páginas oficiais de distribuição.">
<div class="site-shell"><SiteHeader/><main class="simple-page apps-page">
  <div class="eyebrow"><span class="eyebrow-line"></span> NEXAUREN / APLICAÇÕES ANDROID</div>
  <div class="apps-intro"><div><h1>Aplicações úteis.<br/><span>Feitas para o dia a dia.</span></h1><p class="simple-lead">Explora as aplicações Android da Nexauren, compara as funcionalidades e segue para a página oficial de cada aplicação.</p></div><div class="apps-intro-mark" aria-hidden="true"><span>N.</span><small>ANDROID APPS</small></div></div>
  <div class="apps-catalog-toolbar"><div><b>Catálogo de aplicações</b><span>Aplicações publicadas e ligações oficiais</span></div><span class="apps-live-count"><i></i> 5 aplicações listadas</span></div>
  <section class="app-catalog-grid" aria-label="Aplicações Android disponíveis">
    <article class="app-product-card app-product-featured" id="image-tools"><div class="app-product-icon image-product-icon" aria-hidden="true">IT</div><span class="app-product-status">Disponível</span><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>Image Tools: Edit &amp; Resize</h2><p>Um conjunto de ferramentas para editar, redimensionar, comprimir e converter imagens no telemóvel.</p><div class="app-product-meta"><span>51 ferramentas</span><span>Versão 1.21.0</span><span>6,9 MB</span><span>Android 10+</span></div></div><FavoriteButton client:load itemId="app-image-tools" title="Image Tools: Edit & Resize" kind="app" href="https://apkpure.com/p/com.nexauren.imagetools"/><TrackedLink class="primary-button" activityId="open-image-tools-store" activityTitle="Abriu Image Tools na APKPure" href="https://apkpure.com/p/com.nexauren.imagetools">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="archiver"><div class="app-product-icon archiver-product-icon" aria-hidden="true">A</div><span class="app-product-status">Disponível</span><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>Archiver</h2><p>Gestão de arquivos compactados para manter documentos e ficheiros organizados.</p><div class="app-product-meta"><span>Disponível na APKPure</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-archiver" title="Archiver" kind="app" href="https://apkpure.com/p/com.nexauren.archiver"/><TrackedLink class="primary-button" activityId="open-archiver-store" activityTitle="Abriu Archiver na APKPure" href="https://apkpure.com/p/com.nexauren.archiver">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="pdf-max"><div class="app-product-icon pdfmax-product-icon" aria-hidden="true">PDF</div><span class="app-product-status">Disponível</span><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>PDF Max: PDF Editor, Reader &amp; Converter</h2><p>Ferramentas para ler, editar, organizar, comprimir e converter documentos PDF no Android.</p><div class="app-product-meta"><span>Leitor e editor PDF</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-pdf-max" title="PDF Max: PDF Editor, Reader & Converter" kind="app" href="https://apkpure.com/pdf-max-pdf-editor-reader-converter/com.nexauren.pdfmax"/><TrackedLink class="primary-button" activityId="open-pdf-max-store" activityTitle="Abriu PDF Max na APKPure" href="https://apkpure.com/pdf-max-pdf-editor-reader-converter/com.nexauren.pdfmax">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="qr-studio"><div class="app-product-icon qr-product-icon" aria-hidden="true">QR</div><span class="app-product-status">Disponível</span><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>QR Studio</h2><p>Cria, personaliza, lê e organiza códigos QR e códigos de barras diretamente no telemóvel.</p><div class="app-product-meta"><span>QR e códigos de barras</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-qr-studio" title="QR Studio" kind="app" href="https://apkpure.com/qr-studio-qr-code-barcode/com.nexauren.qr_studio"/><TrackedLink class="primary-button" activityId="open-qr-studio-store" activityTitle="Abriu QR Studio na APKPure" href="https://apkpure.com/qr-studio-qr-code-barcode/com.nexauren.qr_studio">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="music-player"><div class="app-product-icon music-product-icon" aria-hidden="true">♫</div><span class="app-product-status">Disponível</span><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>Music Player</h2><p>Leitor de música para ouvir e organizar ficheiros de áudio no dispositivo Android.</p><div class="app-product-meta"><span>Leitor de música</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-music-player" title="Music Player" kind="app" href="https://apkpure.com/br/music-player/com.nexauren.musicplayer2"/><TrackedLink class="primary-button" activityId="open-music-player-store" activityTitle="Abriu Music Player na APKPure" href="https://apkpure.com/br/music-player/com.nexauren.musicplayer2">Abrir página oficial <span>↗</span></TrackedLink></article>
  </section>
  <div class="app-catalog-note" role="note"><b>i</b><span><strong>Confirma os detalhes antes de instalar</strong><small>As versões, dimensões e requisitos podem mudar. Consulta sempre a informação atualizada na página oficial de distribuição.</small></span></div>
  <div class="app-development-strip"><span class="app-development-icon">N.</span><span><b>O ecossistema está em evolução.</b><small>Novas aplicações serão apresentadas aqui quando estiverem prontas para distribuição.</small></span><a href="/account">Guardar favoritos <b>↗</b></a></div>
</main>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Aplicações Android da Nexauren",
  "itemListElement": [
    {"@type":"ListItem","position":1,"item":{"@type":"SoftwareApplication","name":"Image Tools: Edit & Resize","applicationCategory":"UtilitiesApplication","operatingSystem":"Android 10 or later","url":"https://apkpure.com/p/com.nexauren.imagetools"}},
    {"@type":"ListItem","position":2,"item":{"@type":"SoftwareApplication","name":"Archiver","applicationCategory":"UtilitiesApplication","operatingSystem":"Android","url":"https://apkpure.com/p/com.nexauren.archiver"}},
    {"@type":"ListItem","position":3,"item":{"@type":"SoftwareApplication","name":"PDF Max: PDF Editor, Reader & Converter","applicationCategory":"UtilitiesApplication","operatingSystem":"Android","url":"https://apkpure.com/pdf-max-pdf-editor-reader-converter/com.nexauren.pdfmax"}},
    {"@type":"ListItem","position":4,"item":{"@type":"SoftwareApplication","name":"QR Studio","applicationCategory":"UtilitiesApplication","operatingSystem":"Android","url":"https://apkpure.com/qr-studio-qr-code-barcode/com.nexauren.qr_studio"}},
    {"@type":"ListItem","position":5,"item":{"@type":"SoftwareApplication","name":"Music Player","applicationCategory":"MultimediaApplication","operatingSystem":"Android","url":"https://apkpure.com/br/music-player/com.nexauren.musicplayer2"}}
  ]
})}></script>
<SiteFooter/></div></SiteLayout>