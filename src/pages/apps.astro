---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FavoriteButton from "../components/FavoriteButton";
import TrackedLink from "../components/TrackedLink";
---
<SiteLayout title="Apps Android da Nexauren | Image Tools e Archiver" description="Descobre aplicações Android da Nexauren para editar imagens e gerir ficheiros. Consulta funcionalidades, requisitos e as páginas oficiais na APKPure.">
<div class="site-shell"><SiteHeader/><main class="simple-page apps-page">
  <div class="eyebrow"><span class="eyebrow-line"></span> NEXAUREN / APLICAÇÕES</div>
  <h1>Software pensado<br/><span>para o teu dia a dia.</span></h1>
  <p class="simple-lead">Aplicações Android com ferramentas práticas, interfaces cuidadas e foco em utilidade. Consulta os detalhes e visita sempre a página oficial de distribuição.</p>
  <div class="apps-overview-strip">
    <span class="apps-overview-mark">N.</span>
    <div><b>Aplicações Nexauren</b><small>Explora os produtos disponíveis, consulta os detalhes e instala apenas a partir das páginas oficiais.</small></div>
    <a href="#available-apps">Explorar aplicações <span>↓</span></a>
  </div>
  <div class="apps-section-heading" id="available-apps"><span>CATÁLOGO ANDROID</span><h2>Aplicações disponíveis</h2><p>Produtos publicados e respetivas páginas oficiais.</p></div>
  <section class="app-catalog-grid" aria-label="Aplicações Android disponíveis">
    <article class="app-product-card app-product-featured" id="image-tools"><div class="app-product-icon image-product-icon">IT</div><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>Image Tools: Edit &amp; Resize</h2><p>Um conjunto de ferramentas para editar, redimensionar, comprimir e converter imagens no telemóvel.</p><div class="app-product-meta"><span>51 ferramentas</span><span>Versão 1.21.0</span><span>6,9 MB</span><span>Android 10+</span></div></div><FavoriteButton client:load itemId="app-image-tools" title="Image Tools: Edit & Resize" kind="app" href="https://apkpure.com/p/com.nexauren.imagetools"/><TrackedLink class="primary-button" activityId="open-image-tools-store" activityTitle="Abriu Image Tools na APKPure" href="https://apkpure.com/p/com.nexauren.imagetools">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="archiver"><div class="app-product-icon archiver-product-icon">A</div><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>Archiver</h2><p>Gestão de arquivos compactados para manter documentos e ficheiros organizados.</p><div class="app-product-meta"><span>Disponível na APKPure</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-archiver" title="Archiver" kind="app" href="https://apkpure.com/p/com.nexauren.archiver"/><TrackedLink class="primary-button" activityId="open-archiver-store" activityTitle="Abriu Archiver na APKPure" href="https://apkpure.com/p/com.nexauren.archiver">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="pdf-max"><div class="app-product-icon pdfmax-product-icon">PDF</div><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>PDF Max: PDF Editor, Reader &amp; Converter</h2><p>Ferramentas para ler, editar, organizar, comprimir e converter documentos PDF no Android.</p><div class="app-product-meta"><span>Leitor e editor PDF</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-pdf-max" title="PDF Max: PDF Editor, Reader & Converter" kind="app" href="https://apkpure.com/pdf-max-pdf-editor-reader-converter/com.nexauren.pdfmax"/><TrackedLink class="primary-button" activityId="open-pdf-max-store" activityTitle="Abriu PDF Max na APKPure" href="https://apkpure.com/pdf-max-pdf-editor-reader-converter/com.nexauren.pdfmax">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="qr-studio"><div class="app-product-icon qr-product-icon">QR</div><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>QR Studio</h2><p>Cria, personaliza, lê e organiza códigos QR e códigos de barras diretamente no telemóvel.</p><div class="app-product-meta"><span>QR e códigos de barras</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-qr-studio" title="QR Studio" kind="app" href="https://apkpure.com/qr-studio-qr-code-barcode/com.nexauren.qr_studio"/><TrackedLink class="primary-button" activityId="open-qr-studio-store" activityTitle="Abriu QR Studio na APKPure" href="https://apkpure.com/qr-studio-qr-code-barcode/com.nexauren.qr_studio">Abrir página oficial <span>↗</span></TrackedLink></article>
    <article class="app-product-card" id="music-player"><div class="app-product-icon music-product-icon">♫</div><div class="app-product-info"><span class="app-product-label">ANDROID · APKPURE</span><h2>Music Player</h2><p>Leitor de música para ouvir e organizar ficheiros de áudio no dispositivo Android.</p><div class="app-product-meta"><span>Leitor de música</span><span>Android</span></div></div><FavoriteButton client:load itemId="app-music-player" title="Music Player" kind="app" href="https://apkpure.com/br/music-player/com.nexauren.musicplayer2"/><TrackedLink class="primary-button" activityId="open-music-player-store" activityTitle="Abriu Music Player na APKPure" href="https://apkpure.com/br/music-player/com.nexauren.musicplayer2">Abrir página oficial <span>↗</span></TrackedLink></article>
  </section>
  <div class="app-catalog-note" role="note"><b>i</b><span><strong>Confirma os detalhes antes de instalar</strong><small>As versões, dimensões e requisitos podem mudar. Consulta sempre a informação atualizada na página oficial de distribuição.</small></span></div>
  <div class="apps-future-note"><span>✦</span><p><b>Novas aplicações serão adicionadas gradualmente.</b><small>Esta página apresenta apenas produtos com uma página de distribuição identificada.</small></p></div>
  <div class="app-development-strip"><span class="app-development-icon">N.</span><span><b>O ecossistema está em evolução.</b><small>Novas aplicações serão apresentadas aqui quando estiverem prontas para distribuição.</small></span><a href="/account">Guardar favoritos <b>↗</b></a></div>
</main>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Aplicações Android da Nexauren",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "SoftwareApplication",
        "name": "Image Tools: Edit & Resize",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Android 10 or later",
        "url": "https://apkpure.com/p/com.nexauren.imagetools",
        "description": "Ferramentas Android para editar, redimensionar, comprimir e converter imagens."
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "SoftwareApplication",
        "name": "Archiver",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Android",
        "url": "https://apkpure.com/p/com.nexauren.archiver",
        "description": "Aplicação Android para gerir e organizar ficheiros compactados."
      }
    },    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "SoftwareApplication",
        "name": "PDF Max: PDF Editor, Reader & Converter",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Android",
        "url": "https://apkpure.com/pdf-max-pdf-editor-reader-converter/com.nexauren.pdfmax"
      }
    },
    {
      "@type": "ListItem",
      "position": 4,
      "item": {
        "@type": "SoftwareApplication",
        "name": "QR Studio",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Android",
        "url": "https://apkpure.com/qr-studio-qr-code-barcode/com.nexauren.qr_studio"
      }
    },
    {
      "@type": "ListItem",
      "position": 5,
      "item": {
        "@type": "SoftwareApplication",
        "name": "Music Player",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "Android",
        "url": "https://apkpure.com/br/music-player/com.nexauren.musicplayer2"
      }
    }
  ]
})}></script>
<SiteFooter/></div></SiteLayout>