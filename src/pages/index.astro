---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import catalog from "../data/toolCatalog.json";
const featured=catalog.tools.filter((tool)=>tool.featured);
---
<SiteLayout title="Nexauren — 100 ferramentas online para criar, editar e resolver" description="Uma plataforma de ferramentas online em 10 categorias. Trabalha com imagens, PDFs, texto, áudio, conversões, código, cores, cálculos e datas.">
<div class="site-shell"><SiteHeader/><main class="home-premium">
<section class="home-hero home-hero-rebuilt"><div class="home-hero-copy"><div class="eyebrow"><span class="eyebrow-line"></span> NEXAUREN DIGITAL WORKSPACE <span class="hero-live"><i></i> 100 FERRAMENTAS</span></div><h1>O teu próximo<br/><span>trabalho começa aqui.</span></h1><p>Uma plataforma para transformar ficheiros, criar conteúdos, resolver cálculos e acelerar tarefas digitais. Ferramentas com identidade, controlos claros e motores de processamento dedicados.</p><div class="home-hero-actions"><a class="home-primary-cta" href="/tools">Explorar 100 ferramentas <b>↗</b></a><a class="home-secondary-cta" href="/highlights">Ver destaques e conquistas <span>→</span></a></div><div class="home-proof-row"><span><i></i> Processamento local sempre que possível</span><span><i></i> Sem instalação</span><span><i></i> 10 áreas de trabalho</span></div></div>
<div class="hero-visual hero-visual-rebuilt" aria-label="Painel visual das ferramentas Nexauren"><div class="hero-visual-top"><span>NEXAUREN / WORKSPACE</span><span class="hero-live"><i></i> ONLINE</span></div><div class="hero-visual-glow"></div><div class="hero-visual-orbit"><span class="orbit-ring"></span><span class="orbit-ring orbit-two"></span><span class="orbit-core">N.</span><span class="orbit-chip chip-image">IMAGE LAB</span><span class="orbit-chip chip-pdf">PDF ENGINE</span><span class="orbit-chip chip-audio">AUDIO LAB</span><span class="orbit-chip chip-text">DATA TOOLS</span></div><div class="hero-terminal"><span><i></i><i></i><i></i> SYSTEM STATUS</span><b>10 MODULES LOADED</b><small>LOCAL PROCESSING · MULTI-TOOL WORKSPACE</small></div><div class="hero-visual-bottom"><span>01 / 10</span><strong>One platform. Many possibilities.</strong><span>BUILD · CREATE · TRANSFORM</span></div></div></section>
<section class="home-stats home-stats-premium"><div><strong>100</strong><span>Ferramentas disponíveis</span></div><div><strong>10</strong><span>Categorias organizadas</span></div><div><strong>4</strong><span>Idiomas de interface</span></div><div><strong>24/7</strong><span>Acesso online</span></div></section>
<section class="home-section"><div class="home-section-heading"><div><span class="section-kicker">01 / ESCOLHAS DA PLATAFORMA</span><h2>Começa pelos destaques.</h2><p>Atalhos para ferramentas essenciais e muito utilizadas.</p></div><a class="home-section-link" href="/highlights">Todos os destaques ↗</a></div><div class="home-tool-grid">{featured.slice(0,9).map((tool,index)=><a class="home-tool-card home-tool-card-premium" href={"/tools/"+tool.id}><span class="tool-card-icon image-card-icon">{String(index+1).padStart(2,"0")}</span><span class="tool-card-kicker">FEATURED TOOL / {tool.category.toUpperCase()}</span><h3>{tool.name}</h3><p>{tool.description}</p><span class="tool-card-bottom">Abrir ferramenta <b>↗</b></span></a>)}</div></section>
<section class="home-category-band home-category-band-premium"><div class="home-section-heading"><div><span class="section-kicker">02 / EXPLORAR POR ÁREA</span><h2>Um espaço para cada tarefa.</h2><p>Organização clara, sem misturar ferramentas de áreas diferentes.</p></div><a class="home-section-link" href="/tools">Abrir catálogo ↗</a></div><div class="home-category-grid">{catalog.categories.map((category)=><a href={"/tools/"+category.id}><span class="home-category-symbol">{category.icon}</span><span><b>{category.name}</b><small>{category.description}</small></span><span class="category-arrow">↗</span></a>)}</div></section>
<section class="home-security home-security-rebuilt"><div class="security-visual"><span class="security-ring">◈</span><span>LOCAL-FIRST ENGINE</span></div><div><span class="section-kicker">03 / CONTROLO E PRIVACIDADE</span><h2>Os teus ficheiros ficam contigo.</h2><p>As ferramentas de imagem, PDF e áudio processam os ficheiros no navegador sempre que possível. Os favoritos e o histórico da conta são sincronizados através do Firebase quando inicias sessão.</p><a href="/account">Conhecer a conta sincronizada <b>↗</b></a></div></section>
<section class="home-account-cta"><div><span class="section-kicker">04 / O TEU ESPAÇO</span><h2>Favoritos, atividade e <span>conquistas.</span></h2><p>Entra na tua conta para guardar ferramentas e acompanhar o que já exploraste.</p></div><a href="/account">Abrir a minha conta <b>↗</b></a></section>
</main><SiteFooter/></div></SiteLayout>