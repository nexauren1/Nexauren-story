---
import SiteLayout from "../layouts/SiteLayout.astro";
import AuthPanel from "../components/AuthPanel";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<SiteLayout title="Nexauren — Ferramentas online para o dia a dia" description="Edite, comprima e converta imagens, PDFs, áudio e texto com ferramentas online simples, rápidas e seguras.">
<div class="site-shell">
  <SiteHeader />
  <main>
    <section class="tools-hero">
      <div class="eyebrow"><span class="eyebrow-line"></span> FERRAMENTAS ONLINE · NEXAUREN</div>
      <h1>Ferramentas online<br/><span>práticas para o seu dia a dia.</span></h1>
      <p>Edite, comprima e converta os seus ficheiros em segundos. Simples, rápido e diretamente no navegador.</p>
      <form class="tool-search" action="/tools" method="get" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        <input id="home-tool-search" name="q" type="search" placeholder="Pesquise uma ferramenta, ex.: Comprimir PDF..." aria-label="Pesquisar ferramentas"/>
        <button type="submit">Buscar</button>
      </form>
      <div class="popular-tools"><span>Populares:</span><a href="/tools/image-resizer">Image Resizer</a><i>•</i><a href="/tools/pdf-compressor">Comprimir PDF</a><i>•</i><a href="/tools/audio-cutter">Cortar Áudio</a><i>•</i><a href="/tools#text">Contador de Palavras</a></div>
    </section>

    <section class="category-section" id="tools">
      <div class="section-heading"><div><span class="section-kicker">01 / EXPLORAR</span><h2>Categorias</h2><p>Escolha uma categoria e comece agora.</p></div><a class="text-link" href="/tools">Ver todas as ferramentas <span>↗</span></a></div>
      <div class="category-grid">
        <article class="category-card" id="image">
          <div class="category-card-head"><span class="category-icon icon-image"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span><div><h3>Imagem</h3><p>Edição e conversão de imagens</p></div></div>
          <div class="category-tools">
            <a href="/tools/image-resizer"><span>↔</span> Image Resizer</a>
            <a href="/tools/image-resizer"><span>◈</span> Compressor de Imagem</a>
            <a href="/tools/image-resizer"><span>⇄</span> Conversor JPG para PNG</a>
            <a href="/tools/image-resizer"><span>✧</span> Ajustar dimensões</a>
          </div>
          <a class="category-open" href="/tools#image">Explorar imagem <b>↗</b></a>
        </article>

        <article class="category-card" id="pdf">
          <div class="category-card-head"><span class="category-icon icon-pdf"><svg viewBox="0 0 24 24"><path d="M6 2h8l5 5v15H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M14 2v6h5M8 14h8M8 18h6"/></svg></span><div><h3>PDF</h3><p>Trabalhe com arquivos PDF facilmente</p></div></div>
          <div class="category-tools">
            <a href="/tools/pdf-compressor"><span>⇄</span> Comprimir PDF</a>
            <a href="/tools/pdf-compressor"><span>▣</span> Otimizar PDF</a>
            <a href="/tools/pdf-compressor"><span>↧</span> Preparar para partilhar</a>
            <a href="/tools/pdf-compressor"><span>⌕</span> Verificar ficheiros</a>
          </div>
          <a class="category-open" href="/tools#pdf">Explorar PDF <b>↗</b></a>
        </article>

        <article class="category-card" id="text">
          <div class="category-card-head"><span class="category-icon icon-text"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><div><h3>Texto</h3><p>Ferramentas de texto rápidas e úteis</p></div></div>
          <div class="category-tools">
            <a href="/tools#text"><span>☷</span> Contador de Palavras</a>
            <a href="/tools#text"><span>⌁</span> Remover Espaços</a>
            <a href="/tools#text"><span>Aa</span> Maiúsculas e Minúsculas</a>
            <a href="/tools#text"><span>文</span> Traduzir Texto</a>
          </div>
          <a class="category-open" href="/tools#text">Explorar texto <b>↗</b></a>
        </article>

        <article class="category-card" id="audio">
          <div class="category-card-head"><span class="category-icon icon-audio"><svg viewBox="0 0 24 24"><path d="M3 10v4M7 6v12M11 3v18M15 7v10M19 5v14M23 9v6"/></svg></span><div><h3>Áudio</h3><p>Edite e corte os seus ficheiros de áudio</p></div></div>
          <div class="category-tools">
            <a href="/tools/audio-cutter"><span>⌁</span> Cortar Áudio</a>
            <a href="/tools/audio-cutter"><span>♫</span> Extrair trecho de áudio</a>
            <a href="/tools/audio-cutter"><span>◖</span> Pré-visualizar áudio</a>
            <a href="/tools/audio-cutter"><span>⇩</span> Exportar WAV</a>
          </div>
          <a class="category-open" href="/tools#audio">Explorar áudio <b>↗</b></a>
        </article>
      </div>
    </section>

    <section class="popular-section">
      <div class="section-heading"><div><span class="section-kicker">02 / ACESSO RÁPIDO</span><h2>Ferramentas em destaque</h2><p>Comece com uma destas ferramentas.</p></div></div>
      <div class="featured-grid">
        <a class="featured-tool" href="/tools/image-resizer"><span class="featured-icon icon-image">↔</span><span><b>Image Resizer</b><small>Redimensione e comprima imagens</small></span><i>↗</i></a>
        <a class="featured-tool" href="/tools/pdf-compressor"><span class="featured-icon icon-pdf">PDF</span><span><b>Comprimir PDF</b><small>Otimize documentos PDF</small></span><i>↗</i></a>
        <a class="featured-tool" href="/tools/audio-cutter"><span class="featured-icon icon-audio">♫</span><span><b>Cortar Áudio</b><small>Selecione e exporte um trecho</small></span><i>↗</i></a>
      </div>
    </section>

    <section class="account-section" id="account">
      <div class="account-copy"><span class="section-kicker">03 / MINHA CONTA</span><h2>O seu espaço<br/><span>Nexauren.</span></h2><p>Entre para manter os seus favoritos e acompanhar as ferramentas utilizadas. Para iniciar sessão em produção, o domínio deste site tem de estar autorizado em Firebase → Authentication → Settings → Authorized domains.</p></div>
      <AuthPanel client:load/>
    </section>
  </main>
  <SiteFooter/>
</div>
<script>
  const search = document.querySelector("#home-tool-search");
  search?.addEventListener("input", () => {
    const term = search.value.trim().toLocaleLowerCase();
    document.querySelectorAll(".category-card").forEach((card) => {
      const haystack = card.textContent?.toLocaleLowerCase() ?? "";
      card.classList.toggle("search-dimmed", Boolean(term) && !haystack.includes(term));
      card.classList.toggle("search-match", Boolean(term) && haystack.includes(term));
    });
  });
</script>
</SiteLayout>