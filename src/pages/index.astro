---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import catalog from "../data/activeTools.json";
const featured = catalog.tools.filter((tool) => tool.featured);
const getCategory = (id) => catalog.categories.find((category) => category.id === id);
---
<SiteLayout title="Nexauren — Ferramentas online para tarefas digitais" description="Ferramentas online para imagem, PDF, texto e áudio. Processa ficheiros no teu dispositivo, sem instalar programas.">
<div class="site-shell">
  <SiteHeader />
  <main class="nx-home">
    <section class="nx-hero">
      <div class="nx-hero-copy">
        <span class="nx-overline"><i></i> NEXAUREN DIGITAL WORKSPACE</span>
        <h1>As tuas tarefas digitais.<br /><span>Mais simples. Mais rápidas.</span></h1>
        <p>Um espaço organizado para editar imagens, trabalhar com PDFs, transformar texto e ajustar áudio. Escolhe uma ferramenta e começa logo no navegador.</p>
        <div class="nx-hero-actions">
          <a class="nx-button nx-button-primary" href="/tools">Explorar ferramentas <span>↗</span></a>
          <a class="nx-button nx-button-quiet" href="/apps">Conhecer aplicações <span>→</span></a>
        </div>
        <div class="nx-hero-trust">
          <span><b>01</b> Sem instalação</span>
          <span><b>02</b> Processamento local</span>
          <span><b>03</b> Acesso no navegador</span>
        </div>
      </div>
      <div class="nx-hero-visual" aria-label="Pré-visualização do espaço de ferramentas Nexauren">
        <div class="nx-visual-top">
          <span class="nx-visual-brand"><i>N.</i> NEXAUREN / WORKSPACE</span>
          <span class="nx-online"><i></i> ONLINE</span>
        </div>
        <div class="nx-visual-heading">
          <small>O TEU ESPAÇO DE TRABALHO</small>
          <strong>Escolhe uma área<br />e começa a criar.</strong>
        </div>
        <div class="nx-visual-modules">
          {catalog.categories.map((category) => (
            <a href={"/tools/" + category.id} class="nx-visual-module" data-tone={category.tone}>
              <span class="nx-module-icon">{category.icon}</span>
              <span><b>{category.name}</b><small>{catalog.tools.filter((tool) => tool.category === category.id).length} ferramentas</small></span>
              <i>↗</i>
            </a>
          ))}
        </div>
        <div class="nx-visual-foot"><span>LOCAL-FIRST TOOLS</span><span>DESIGNED FOR EVERYDAY WORK</span></div>
      </div>
    </section>

    <section class="nx-proof-row" aria-label="Resumo da plataforma">
      <div><strong>{catalog.tools.length.toString().padStart(2, "0")}</strong><span>ferramentas activas</span></div>
      <div><strong>{catalog.categories.length.toString().padStart(2, "0")}</strong><span>áreas organizadas</span></div>
      <div><strong>100%</strong><span>no navegador, sem instalação</span></div>
      <div class="nx-proof-note"><i>◈</i><span>Os ficheiros das ferramentas compatíveis são processados localmente no teu dispositivo.</span></div>
    </section>

    <section class="nx-section nx-reveal">
      <div class="nx-section-heading">
        <div><span class="nx-section-label">COMEÇA POR AQUI</span><h2>Ferramentas em destaque</h2><p>Atalhos para as funções mais procuradas da plataforma.</p></div>
        <a class="nx-text-link" href="/tools">Ver todas as ferramentas <span>↗</span></a>
      </div>
      <div class="nx-tool-grid nx-featured-grid">
        {featured.map((tool) => {
          const category = getCategory(tool.category);
          return (
            <a class="nx-tool-card" href={tool.path} data-tone={category?.tone ?? "blue"}>
              <div class="nx-tool-card-top"><span class="nx-tool-icon">{tool.icon}</span><span class="nx-tool-category">{category?.name}</span></div>
              <h3>{tool.name}</h3><p>{tool.description}</p>
              <span class="nx-tool-card-action">Abrir ferramenta <b>↗</b></span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="nx-section nx-category-section nx-reveal">
      <div class="nx-section-heading">
        <div><span class="nx-section-label">TUDO NO SEU LUGAR</span><h2>Explora por categoria</h2><p>Quatro áreas separadas para encontrares rapidamente o que precisas.</p></div>
        <a class="nx-text-link" href="/tools">Abrir catálogo <span>↗</span></a>
      </div>
      <div class="nx-category-grid">
        {catalog.categories.map((category) => {
          const total = catalog.tools.filter((tool) => tool.category === category.id).length;
          return (
            <a class="nx-category-card" href={"/tools/" + category.id} data-tone={category.tone}>
              <span class="nx-category-icon">{category.icon}</span>
              <span class="nx-category-copy"><b>{category.name}</b><small>{category.description}</small></span>
              <span class="nx-category-count">{total.toString().padStart(2, "0")} <i>ferramentas</i></span>
              <span class="nx-category-arrow">↗</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="nx-how-section nx-reveal">
      <div class="nx-how-intro">
        <span class="nx-section-label">FEITO PARA SER SIMPLES</span>
        <h2>Escolhe. Processa.<br /><span>Guarda o resultado.</span></h2>
        <p>Não precisas de instalar programas nem de enviar os teus ficheiros para começar a trabalhar.</p>
        <a class="nx-text-link" href="/tools">Encontrar uma ferramenta <span>↗</span></a>
      </div>
      <div class="nx-how-steps">
        <div><b>01</b><span><strong>Escolhe a ferramenta</strong><small>Entra na categoria certa e abre a função de que precisas.</small></span></div>
        <div><b>02</b><span><strong>Adiciona o teu ficheiro ou texto</strong><small>Usa os controlos próprios de cada ferramenta.</small></span></div>
        <div><b>03</b><span><strong>Descarrega o resultado</strong><small>Guarda o ficheiro final directamente no teu dispositivo.</small></span></div>
      </div>
    </section>

    <section class="nx-bottom-cta nx-reveal">
      <div><span class="nx-section-label">O TEU ESPAÇO PESSOAL</span><h2>Guarda o que usas mais.</h2><p>Inicia sessão para guardar favoritos e consultar a tua actividade em diferentes dispositivos.</p></div>
      <a class="nx-button nx-button-light" href="/account">Abrir a minha conta <span>↗</span></a>
    </section>
  </main>
  <SiteFooter />
</div>
</SiteLayout>