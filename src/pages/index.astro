---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import catalog from "../data/activeTools.json";
const featured = catalog.tools.filter((tool) => tool.featured).slice(0, 8);
const getCategory = (id) => catalog.categories.find((category) => category.id === id);
---
<SiteLayout title="Nexauren Story — Ferramentas online gratuitas e tecnologia" description="Ferramentas online gratuitas para imagens, PDF, texto e áudio. Explore utilitários digitais e artigos práticos de tecnologia na Nexauren Story.">
<div class="site-shell">
  <SiteHeader />
  <main class="ns-main ns-home">
    <section class="ns-hero">
      <div class="ns-hero-copy">
        <span class="ns-eyebrow"><i>⚡</i> O TEU CENTRO DE TECNOLOGIA</span>
        <h1>Ferramentas, tecnologia<br/>e inovação <span>num só lugar.</span></h1>
        <p>Descobre ferramentas online poderosas, lê artigos úteis e acompanha as novidades tecnológicas. Tudo num espaço rápido, seguro e fácil de utilizar.</p>
        <div class="ns-hero-actions">
          <a class="ns-button ns-button-primary" href="/tools">Explorar ferramentas <span>↗</span></a>
          <a class="ns-button ns-button-outline" href="/blog">Ler o blog <span>→</span></a>
        </div>
        <form class="ns-hero-search" action="/tools" method="get" role="search">
          <span aria-hidden="true">⌕</span>
          <input type="search" name="q" placeholder="Pesquisa uma ferramenta ou solução..." aria-label="Pesquisar ferramentas ou soluções"/>
          <button type="submit">Pesquisar <span>↗</span></button>
        </form>
        <div class="ns-trust-inline"><span>⚡ Rápido e gratuito</span><span>◈ Privacidade primeiro</span><span>☁ Sem instalação</span></div>
      </div>
      <div class="ns-hero-art" aria-label="Ilustração tecnológica Nexauren Story">
        <div class="ns-orbit ns-orbit-one"></div><div class="ns-orbit ns-orbit-two"></div><div class="ns-orbit ns-orbit-three"></div>
        <div class="ns-laptop">
          <div class="ns-laptop-screen"><div class="ns-screen-mark">N</div><small>NEXAUREN STORY</small></div>
          <div class="ns-laptop-base"><span></span></div>
        </div>
        <div class="ns-float-tile ns-tile-image">▧</div><div class="ns-float-tile ns-tile-pdf">PDF</div><div class="ns-float-tile ns-tile-code">⌘</div><div class="ns-float-tile ns-tile-play">▶</div>
        <div class="ns-art-caption"><i></i> FERRAMENTAS ONLINE / TECNOLOGIA / IDEIAS</div>
      </div>
    </section>

    <section class="ns-stat-strip" aria-label="Resumo da plataforma">
      <div class="ns-stat"><span class="ns-stat-icon blue">✦</span><span><b>{catalog.tools.length}+</b><small>Ferramentas úteis</small></span></div>
      <div class="ns-stat"><span class="ns-stat-icon green">◈</span><span><b>100%</b><small>Foco na privacidade</small></span></div>
      <div class="ns-stat"><span class="ns-stat-icon purple">⚡</span><span><b>Rápido</b><small>Processamento no navegador</small></span></div>
      <div class="ns-stat"><span class="ns-stat-icon cyan">◎</span><span><b>Gratuito</b><small>Sem instalação</small></span></div>
    </section>

    <section class="ns-section ns-reveal">
      <div class="ns-section-heading">
        <div><span class="ns-section-kicker">EXPLORA A PLATAFORMA</span><h2>Ferramentas para <em>cada tarefa.</em></h2><p>Escolhe uma categoria e encontra rapidamente a ferramenta certa.</p></div>
        <a class="ns-text-link" href="/tools">Ver todas as ferramentas <b>↗</b></a>
      </div>
      <div class="ns-category-grid">
        {catalog.categories.map((category, index) => {
          const total = catalog.tools.filter((tool) => tool.category === category.id).length;
          return <a class="ns-category-card" href={"/tools/" + category.id} data-tone={category.tone}>
            <div class="ns-category-card-top"><span class="ns-category-icon">{category.icon}</span><span class="ns-category-index">0{index + 1}</span></div>
            <h3>{category.name}</h3><p>{category.description}</p>
            <div class="ns-category-bottom"><span>{total} ferramentas</span><b>↗</b></div>
          </a>;
        })}
      </div>
    </section>

    <section class="ns-section ns-reveal">
      <div class="ns-section-heading">
        <div><span class="ns-section-kicker">ESCOLHAS POPULARES</span><h2>Ferramentas em <em>destaque.</em></h2><p>Atalhos para funções úteis que podes utilizar diretamente no navegador.</p></div>
        <a class="ns-text-link" href="/tools">Explorar o catálogo <b>↗</b></a>
      </div>
      <div class="ns-tool-grid ns-featured-grid">
        {featured.map((tool) => {
          const category = getCategory(tool.category);
          return <a class="ns-tool-card" href={tool.path} data-tone={category?.tone ?? "blue"}>
            <div class="ns-tool-card-top"><span class="ns-tool-icon">{tool.icon}</span><span class="ns-tool-pill">{category?.name}</span></div>
            <h3>{tool.name}</h3><p>{tool.description}</p>
            <span class="ns-tool-card-link">Abrir ferramenta <b>↗</b></span>
          </a>;
        })}
      </div>
    </section>

    <section class="ns-feature-band ns-reveal">
      <div class="ns-feature-band-copy"><span class="ns-section-kicker">MAIS DO QUE FERRAMENTAS</span><h2>Aprende algo novo.<br/><em>Usa melhor a tecnologia.</em></h2><p>Guias passo a passo, comparações, recomendações de aplicações e explicações para resolver problemas digitais do dia a dia.</p><a class="ns-button ns-button-primary" href="/blog">Explorar artigos <span>↗</span></a></div>
      <div class="ns-feature-band-art"><div class="ns-blog-screen"><div class="ns-blog-screen-top"><span></span><span></span><span></span></div><div class="ns-blog-screen-image">N.</div><b>Conhecimento que ajuda.</b><small>Guias · Tutoriais · Tecnologia</small></div><div class="ns-feature-orbit"></div></div>
    </section>

    <section class="ns-section ns-reveal">
      <div class="ns-section-heading"><div><span class="ns-section-kicker">COMEÇA EM TRÊS PASSOS</span><h2>Simples desde o <em>primeiro clique.</em></h2></div></div>
      <div class="ns-steps-grid">
        <article><span>01</span><b>Escolhe uma ferramenta</b><p>Pesquisa no catálogo ou navega pelas categorias.</p></article>
        <article><span>02</span><b>Adiciona o teu ficheiro</b><p>Usa os controlos próprios de cada ferramenta.</p></article>
        <article><span>03</span><b>Guarda o resultado</b><p>Descarrega o ficheiro processado no teu dispositivo.</p></article>
      </div>
    </section>
    <section class="ns-bottom-cta ns-reveal"><div><span class="ns-section-kicker">O TEU ESPAÇO PESSOAL</span><h2>Guarda as tuas ferramentas favoritas.</h2><p>Inicia sessão para sincronizar favoritos e atividade entre dispositivos.</p></div><a class="ns-button ns-button-primary" href="/account">Abrir a minha conta <span>↗</span></a></section>
  </main>
  <SiteFooter />
</div>
</SiteLayout>