---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import catalog from "../data/toolCatalog.json";
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---
<SiteLayout title="100 ferramentas online gratuitas — Nexauren" description="Explora 100 ferramentas online em 10 categorias: imagem, PDF, texto, áudio, conversores, geradores, calculadoras, programação, cores e datas.">
<div class="site-shell"><SiteHeader/><main class="simple-page tools-catalog-page">
<div class="eyebrow"><span class="eyebrow-line"></span> NEXAUREN / CENTRAL DE FERRAMENTAS</div>
<h1>Uma plataforma.<br/><span>100 ferramentas para criar e resolver.</span></h1><p class="simple-lead">Pesquisa uma função, escolhe uma categoria e abre um espaço de trabalho próprio. Os ficheiros são processados no teu dispositivo sempre que tecnicamente possível.</p>
<div class="catalog-search"><span>⌕</span><input id="catalog-search" type="search" value={initialQuery} placeholder="Pesquisar por nome, função ou categoria…" aria-label="Pesquisar ferramentas"/><kbd>100 TOOLS</kbd></div>
<div class="catalog-category-pills">{catalog.categories.map((category)=><a href={"/tools/"+category.id}>{category.name}<b>{catalog.tools.filter((tool)=>tool.category===category.id).length}</b></a>)}</div>
<div class="catalog-results-heading"><div><span class="section-kicker">BIBLIOTECA COMPLETA</span><h2>Todas as ferramentas</h2></div><span id="catalog-count">100 ferramentas</span></div>
{catalog.categories.map((category)=><section class="catalog-section" data-catalog-section={category.id}><div class="catalog-section-heading"><div><span class="catalog-section-icon">{category.icon}</span><div><h3>{category.name}</h3><p>{category.description}</p></div></div><a href={"/tools/"+category.id}>Ver categoria ↗</a></div><div class="tool-list-grid tool-list-grid-premium">{catalog.tools.filter((tool)=>tool.category===category.id).map((tool)=><a class="tool-list-card" data-tool-card data-search={(tool.name+" "+tool.description+" "+category.name).toLowerCase()} href={"/tools/"+tool.id}><span class="tool-list-icon">{category.icon}</span><span><b>{tool.name}</b><small>{tool.description}</small></span><i>↗</i></a>)}</div></section>)}
<p id="catalog-empty" class="catalog-empty" hidden>Não encontrámos ferramentas com essa pesquisa.</p></main><SiteFooter/></div>
<script>
const search=document.querySelector("#catalog-search");const cards=[...document.querySelectorAll("[data-tool-card]")];const sections=[...document.querySelectorAll("[data-catalog-section]")];const count=document.querySelector("#catalog-count");const empty=document.querySelector("#catalog-empty");
function filterTools(){const query=(search?.value||"").trim().toLocaleLowerCase();let visible=0;cards.forEach((card)=>{const match=!query||(card.getAttribute("data-search")||"").includes(query);card.hidden=!match;if(match)visible++;});sections.forEach((section)=>{section.hidden=!section.querySelector("[data-tool-card]:not([hidden])");});if(count)count.textContent=visible+(visible===1?" ferramenta":" ferramentas");if(empty)empty.hidden=visible!==0;}
search?.addEventListener("input",filterTools);filterTools();
</script></SiteLayout>