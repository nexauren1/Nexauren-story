---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import catalog from "../data/activeTools.json";
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---
<SiteLayout title="Categorias de ferramentas online — Nexauren" description="Escolhe uma categoria Nexauren: imagem, PDF, texto ou áudio. Cada categoria tem uma página própria com as suas ferramentas.">
<div class="site-shell">
  <SiteHeader />
  <main class="nx-catalog-page nx-category-directory">
    <header class="nx-page-heading">
      <span class="nx-overline"><i></i> CENTRAL DE FERRAMENTAS</span>
      <h1>Escolhe uma categoria<br /><span>para começares.</span></h1>
      <p>As ferramentas estão organizadas por área. Abre uma categoria para veres as funções disponíveis e escolheres a que precisas.</p>
      <div class="nx-catalog-meta">
        <span><b>{catalog.categories.length}</b> categorias</span>
        <span class="nx-meta-dot"></span>
        <span><b>{catalog.tools.length}</b> ferramentas disponíveis</span>
      </div>
    </header>

    <section class="nx-catalog-controls nx-category-directory-controls" aria-label="Pesquisar categorias">
      <label class="nx-search-box">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
        <input id="category-search" type="search" value={initialQuery} placeholder="Pesquisar categoria…" aria-label="Pesquisar categorias" autocomplete="off" />
        <button id="category-clear" type="button" aria-label="Limpar pesquisa" hidden>Limpar</button>
      </label>
    </section>

    <div class="nx-catalog-results-heading">
      <div><span class="nx-section-label">EXPLORAR POR ÁREA</span><h2>Todas as categorias</h2></div>
      <span id="category-count">{catalog.categories.length} categorias</span>
    </div>

    <section class="nx-category-directory-grid" aria-label="Categorias disponíveis">
      {catalog.categories.map((category, index) => {
        const tools = catalog.tools.filter((tool) => tool.category === category.id);
        return (
          <a class="nx-directory-category-card" data-category-card data-search={(category.name + " " + category.description).toLocaleLowerCase()} href={"/tools/" + category.id} data-tone={category.tone}>
            <div class="nx-directory-card-top">
              <span class="nx-category-icon" data-tone={category.tone}>{category.icon}</span>
              <span class="nx-directory-index">{String(index + 1).padStart(2, "0")} / {String(catalog.categories.length).padStart(2, "0")}</span>
            </div>
            <h2>{category.name}</h2>
            <p>{category.description}</p>
            <div class="nx-directory-card-bottom">
              <span><b>{String(tools.length).padStart(2, "0")}</b> {tools.length === 1 ? "ferramenta disponível" : "ferramentas disponíveis"}</span>
              <span class="nx-directory-open">Abrir categoria <b>↗</b></span>
            </div>
          </a>
        );
      })}
    </section>
    <p id="category-empty" class="nx-empty-state" hidden>Não encontrámos essa categoria. Experimenta outro nome.</p>
    <div class="nx-catalog-footnote"><span>◈</span> Cada categoria tem a sua própria página e apresenta apenas as ferramentas dessa área.</div>
  </main>
  <SiteFooter />
</div>
<script>
const search = document.querySelector("#category-search");
const clear = document.querySelector("#category-clear");
const cards = [...document.querySelectorAll("[data-category-card]")];
const count = document.querySelector("#category-count");
const empty = document.querySelector("#category-empty");
function filterCategories() {
  const query = (search?.value || "").trim().toLocaleLowerCase();
  let visible = 0;
  cards.forEach((card) => {
    const matches = !query || (card.getAttribute("data-search") || "").includes(query);
    card.hidden = !matches;
    if (matches) visible++;
  });
  if (count) count.textContent = visible + (visible === 1 ? " categoria" : " categorias");
  if (empty) empty.hidden = visible !== 0;
  if (clear) clear.hidden = !query;
}
search?.addEventListener("input", filterCategories);
clear?.addEventListener("click", () => { if (search) search.value = ""; search?.focus(); filterCategories(); });
filterCategories();
</script>
</SiteLayout>