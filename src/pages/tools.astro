---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<SiteLayout title="Ferramentas online — Nexauren" description="Explore ferramentas para imagens, PDF, texto e áudio. Edite e converta ficheiros diretamente no seu navegador.">
<div class="site-shell">
  <SiteHeader/>
  <main>
    <section class="tools-hero tools-hero-compact">
      <div class="eyebrow"><span class="eyebrow-line"></span> CENTRAL DE FERRAMENTAS</div>
      <h1>Encontre a ferramenta<br/><span>certa para cada tarefa.</span></h1>
      <p>Escolha uma categoria ou pesquise pelo nome da ferramenta.</p>
      <div class="tool-search">
        <svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        <input id="tool-catalog-search" type="search" placeholder="Pesquisar ferramentas..." aria-label="Pesquisar ferramentas"/>
        <button type="button" id="tool-search-clear">Limpar</button>
      </div>
    </section>

    <section class="catalog-section" id="image">
      <div class="section-heading"><div><span class="section-kicker">01 / IMAGEM</span><h2>Imagem</h2><p>Redimensione, comprima e transforme as suas imagens.</p></div><span class="category-count">4 ferramentas</span></div>
      <div class="tool-list-grid">
        <a class="tool-list-card" href="/tools/image-resizer" data-tool-name="image resizer redimensionar imagem comprimir jpeg png webp">
          <span class="tool-list-icon icon-image">↔</span><span><b>Image Resizer</b><small>Redimensionar, comprimir e converter JPEG, PNG e WebP.</small></span><i>↗</i>
        </a>
        <a class="tool-list-card" href="/tools/image-resizer" data-tool-name="compressor de imagem reduzir tamanho foto">
          <span class="tool-list-icon icon-image">◈</span><span><b>Compressor de Imagem</b><small>Reduza o peso das imagens com controlo de qualidade.</small></span><i>↗</i>
        </a>
        <a class="tool-list-card" href="/tools/image-resizer" data-tool-name="converter imagem jpg png webp avif formato">
          <span class="tool-list-icon icon-image">⇄</span><span><b>Conversor de Imagem</b><small>Exporte imagens para JPEG, PNG ou WebP.</small></span><i>↗</i>
        </a>
        <a class="tool-list-card" href="/tools/image-resizer" data-tool-name="ajustar dimensoes cortar imagem">
          <span class="tool-list-icon icon-image">⌗</span><span><b>Ajustar Dimensões</b><small>Defina largura, altura e proporção da imagem.</small></span><i>↗</i>
        </a>
      </div>
    </section>

    <section class="catalog-section" id="pdf">
      <div class="section-heading"><div><span class="section-kicker">02 / DOCUMENTOS</span><h2>PDF</h2><p>Ferramentas para organizar e otimizar documentos PDF.</p></div><span class="category-count">1 ferramenta ativa</span></div>
      <div class="tool-list-grid">
        <a class="tool-list-card" href="/tools/pdf-compressor" data-tool-name="comprimir pdf otimizador pdf tamanho documento">
          <span class="tool-list-icon icon-pdf">PDF</span><span><b>Comprimir PDF</b><small>Regrave e otimize a estrutura dos seus documentos PDF.</small></span><i>↗</i>
        </a>
        <a class="tool-list-card is-coming" href="#pdf" data-tool-name="juntar unir combinar pdf" aria-disabled="true">
          <span class="tool-list-icon icon-pdf">▣</span><span><b>Juntar PDF</b><small>Combine vários documentos num só ficheiro.</small></span><em>Em breve</em>
        </a>
        <a class="tool-list-card is-coming" href="#pdf" data-tool-name="dividir separar pdf páginas" aria-disabled="true">
          <span class="tool-list-icon icon-pdf">✂</span><span><b>Dividir PDF</b><small>Separe páginas e intervalos de páginas.</small></span><em>Em breve</em>
        </a>
        <a class="tool-list-card is-coming" href="#pdf" data-tool-name="pdf para word converter docx" aria-disabled="true">
          <span class="tool-list-icon icon-pdf">W</span><span><b>PDF para Word</b><small>Prepare documentos para edição.</small></span><em>Em breve</em>
        </a>
      </div>
    </section>

    <section class="catalog-section" id="text">
      <div class="section-heading"><div><span class="section-kicker">03 / TEXTO</span><h2>Texto</h2><p>Pequenas ferramentas para trabalhar com texto.</p></div><span class="category-count">Em preparação</span></div>
      <div class="tool-list-grid">
        <a class="tool-list-card is-coming" href="#text" data-tool-name="contador de palavras caracteres texto" aria-disabled="true"><span class="tool-list-icon icon-text">☷</span><span><b>Contador de Palavras</b><small>Conte palavras, caracteres e linhas.</small></span><em>Em breve</em></a>
        <a class="tool-list-card is-coming" href="#text" data-tool-name="remover espaços texto limpar" aria-disabled="true"><span class="tool-list-icon icon-text">⌁</span><span><b>Remover Espaços</b><small>Limpe espaços e linhas desnecessárias.</small></span><em>Em breve</em></a>
        <a class="tool-list-card is-coming" href="#text" data-tool-name="maiúsculas minúsculas converter texto" aria-disabled="true"><span class="tool-list-icon icon-text">Aa</span><span><b>Maiúsculas e Minúsculas</b><small>Transforme a capitalização do texto.</small></span><em>Em breve</em></a>
        <a class="tool-list-card is-coming" href="#text" data-tool-name="traduzir texto tradução idioma" aria-disabled="true"><span class="tool-list-icon icon-text">文</span><span><b>Traduzir Texto</b><small>Traduza textos entre diferentes idiomas.</small></span><em>Em breve</em></a>
      </div>
    </section>

    <section class="catalog-section" id="audio">
      <div class="section-heading"><div><span class="section-kicker">04 / ÁUDIO</span><h2>Áudio</h2><p>Corte e prepare os seus ficheiros de áudio.</p></div><span class="category-count">1 ferramenta ativa</span></div>
      <div class="tool-list-grid">
        <a class="tool-list-card" href="/tools/audio-cutter" data-tool-name="cortar audio mp3 wav trim remover trecho">
          <span class="tool-list-icon icon-audio">♫</span><span><b>Cortar Áudio</b><small>Selecione o início e o fim e exporte o trecho em WAV.</small></span><i>↗</i>
        </a>
        <a class="tool-list-card is-coming" href="#audio" data-tool-name="converter mp3 áudio formato" aria-disabled="true"><span class="tool-list-icon icon-audio">MP3</span><span><b>Conversor de Áudio</b><small>Converta ficheiros para formatos de áudio populares.</small></span><em>Em breve</em></a>
        <a class="tool-list-card is-coming" href="#audio" data-tool-name="reduzir ruído áudio limpar" aria-disabled="true"><span class="tool-list-icon icon-audio">≋</span><span><b>Reduzir Ruído</b><small>Reduza ruído de fundo nas gravações.</small></span><em>Em breve</em></a>
        <a class="tool-list-card is-coming" href="#audio" data-tool-name="extrair áudio ficheiro" aria-disabled="true"><span class="tool-list-icon icon-audio">⇩</span><span><b>Extrair Áudio</b><small>Extraia áudio de ficheiros compatíveis.</small></span><em>Em breve</em></a>
      </div>
    </section>

    <p class="catalog-empty" id="catalog-empty" hidden>Não encontrámos ferramentas com esse nome.</p>
  </main>
  <SiteFooter/>
</div>
<script>
  const input=document.querySelector("#tool-catalog-search");
  const clear=document.querySelector("#tool-search-clear");
  const cards=[...document.querySelectorAll("[data-tool-name]")];
  const empty=document.querySelector("#catalog-empty");
  function filterTools(){
    const q=(input?.value??"").trim().toLocaleLowerCase();
    let count=0;
    cards.forEach(card=>{
      const match=!q||(card.getAttribute("data-tool-name")??"").toLocaleLowerCase().includes(q);
      card.hidden=!match;
      if(match)count++;
    });
    document.querySelectorAll(".catalog-section").forEach(section=>{
      section.hidden=!section.querySelector("[data-tool-name]:not([hidden])");
    });
    if(empty)empty.hidden=count!==0;
  }
  input?.addEventListener("input",filterTools);
  clear?.addEventListener("click",()=>{if(input)input.value="";filterTools();input?.focus();});
  document.querySelectorAll(".is-coming").forEach(card=>card.addEventListener("click",event=>event.preventDefault()));
  const params=new URLSearchParams(location.search);if(params.get("q")&&input){input.value=params.get("q");filterTools();}
</script>
</SiteLayout>