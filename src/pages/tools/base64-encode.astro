---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Codificar texto Base64 — Ferramenta online | Nexauren" description="Codifica texto para Base64 usando UTF-8, incluindo caracteres acentuados.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/text">Texto</a><span>›</span><span>Codificar texto Base64</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / TEXT LAB</span><h1>Codificar texto Base64</h1><p>Codifica texto para Base64 usando UTF-8, incluindo caracteres acentuados.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="base64-encode" title="Codificar texto Base64" kind="tool" href="/tools/base64-encode"/></div></header>
<UniversalTool client:load toolId="base64-encode" name="Codificar texto Base64" category="text" description="Codifica texto para Base64 usando UTF-8, incluindo caracteres acentuados." kind="text"/>
<TrackActivity client:load activityId="base64-encode" activityTitle="Usou Codificar texto Base64"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Copiar ou guardar resultado</span></section>
</main><SiteFooter/></div></SiteLayout>