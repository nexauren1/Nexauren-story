---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PDFSplitter from "../../components/PDFSplitter";
import TrackActivity from "../../components/TrackActivity";
---
<SiteLayout title="Extrair páginas PDF — PDF Splitter | Nexauren" description="Extrai páginas ou intervalos de um PDF e cria um novo documento no navegador.">
<div class="site-shell"><SiteHeader/><main class="tool-page">
  <div class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/pdf">PDF</a><span>›</span><span>Extrair páginas</span></div>
  <header class="tool-page-header"><div class="tool-title"><h1>Extrair páginas PDF</h1><p>Seleciona intervalos como 1-3,5,8-10 e gera um documento separado.</p></div><span class="tool-state"><i/> PROCESSAMENTO LOCAL</span></header>
  <PDFSplitter client:load/><TrackActivity client:load activityId="tool-pdf-splitter" activityTitle="Extraiu páginas de um PDF"/>
  <p class="tool-footer-note">Nexauren · PDF Splitter · <a href="/privacy">Privacidade</a></p>
</main><SiteFooter/></div></SiteLayout>