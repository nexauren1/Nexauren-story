---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Reordenar páginas PDF — Ferramenta online | Nexauren" description="Define uma sequência de páginas personalizada e reorganiza o PDF numa nova cópia.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/pdf">PDF</a><span>›</span><span>Reordenar páginas PDF</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / PDF LAB</span><h1>Reordenar páginas PDF</h1><p>Define uma sequência de páginas personalizada e reorganiza o PDF numa nova cópia.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="pdf-reorder-pages" title="Reordenar páginas PDF" kind="tool" href="/tools/pdf-reorder-pages"/></div></header>
<UniversalTool client:load toolId="pdf-reorder-pages" name="Reordenar páginas PDF" category="pdf" description="Define uma sequência de páginas personalizada e reorganiza o PDF numa nova cópia." kind="pdf"/>
<TrackActivity client:load activityId="pdf-reorder-pages" activityTitle="Usou Reordenar páginas PDF"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>