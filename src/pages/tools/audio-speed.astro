---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Alterar velocidade do áudio — Ferramenta online | Nexauren" description="Acelera ou abranda o áudio entre 0,5× e 2×, ajustando a duração do ficheiro.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/audio">Áudio</a><span>›</span><span>Alterar velocidade do áudio</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / AUDIO LAB</span><h1>Alterar velocidade do áudio</h1><p>Acelera ou abranda o áudio entre 0,5× e 2×, ajustando a duração do ficheiro.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="audio-speed" title="Alterar velocidade do áudio" kind="tool" href="/tools/audio-speed"/></div></header>
<UniversalTool client:load toolId="audio-speed" name="Alterar velocidade do áudio" category="audio" description="Acelera ou abranda o áudio entre 0,5× e 2×, ajustando a duração do ficheiro." kind="audio"/>
<TrackActivity client:load activityId="audio-speed" activityTitle="Usou Alterar velocidade do áudio"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>