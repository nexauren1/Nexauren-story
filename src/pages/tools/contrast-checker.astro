---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Verificador de contraste — Ferramenta online | Nexauren Story" description="Calcula contraste entre duas cores.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/colors">Cores e design</a><span>›</span><span aria-current="page">Verificador de contraste</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">◐</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Verificador de contraste</h1><p>Calcula contraste entre duas cores.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="contrast-checker" title="Verificador de contraste" kind="tool" href="/tools/contrast-checker"/></div>
  </header>
  <UniversalTool client:load toolId="contrast-checker" name="Verificador de contraste" category="colors" description="Calcula contraste entre duas cores." kind="colors"/>
  <TrackActivity client:load activityId="contrast-checker" activityTitle="Usou Verificador de contraste"/>
</main><SiteFooter/></div>
</SiteLayout>
