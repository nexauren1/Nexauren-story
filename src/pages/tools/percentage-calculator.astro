---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Calculadora de percentagem — Ferramenta online | Nexauren Story" description="Calcula percentagens de um valor.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/calculators">Calculadoras</a><span>›</span><span aria-current="page">Calculadora de percentagem</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">%</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Calculadora de percentagem</h1><p>Calcula percentagens de um valor.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="percentage-calculator" title="Calculadora de percentagem" kind="tool" href="/tools/percentage-calculator"/></div>
  </header>
  <UniversalTool client:load toolId="percentage-calculator" name="Calculadora de percentagem" category="calculators" description="Calcula percentagens de um valor." kind="calculators"/>
  <TrackActivity client:load activityId="percentage-calculator" activityTitle="Usou Calculadora de percentagem"/>
</main><SiteFooter/></div>
</SiteLayout>
