---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import ImageCompressor from "../../components/ImageCompressor";
---
<SiteLayout title="Comprimir imagens online — JPG, PNG e WebP | Nexauren Story" description="Comprime imagens JPG, PNG e WebP gratuitamente. Ajusta qualidade, formato e dimensões, compara o tamanho e descarrega o resultado sem enviar ficheiros para um servidor.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/image">Imagem</a><span>›</span><span aria-current="page">Compressor de imagens</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">▧</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / LABORATÓRIO DE IMAGEM / COMPRESSOR</span><h1>Compressor de imagens online</h1><p>Reduz o tamanho dos ficheiros, escolhe o formato e controla a qualidade antes de descarregar.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="image-compressor" title="Comprimir imagens" kind="tool" href="/tools/image-compressor"/></div>
  </header>
  <section class="ns-tool-benefits"><span>✓ JPG · PNG · WebP</span><span>✓ Ajuste de qualidade</span><span>✓ Redimensionamento opcional</span><span>✓ Processamento local</span></section>
  <ImageCompressor client:load/>
  <TrackActivity client:load activityId="image-compressor" activityTitle="Usou o compressor de imagens"/>
</main><SiteFooter/></div>
</SiteLayout>