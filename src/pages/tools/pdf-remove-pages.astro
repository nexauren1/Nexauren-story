---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Remover páginas PDF — Ferramenta online | Nexauren" description="Remove páginas seleccionadas e cria uma nova cópia sem alterar o documento original.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/pdf">PDF</a><span>›</span><span>Remover páginas PDF</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / PDF LAB</span><h1>Remover páginas PDF</h1><p>Remove páginas seleccionadas e cria uma nova cópia sem alterar o documento original.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="pdf-remove-pages" title="Remover páginas PDF" kind="tool" href="/tools/pdf-remove-pages"/></div></header>
<UniversalTool client:load toolId="pdf-remove-pages" name="Remover páginas PDF" category="pdf" description="Remove páginas seleccionadas e cria uma nova cópia sem alterar o documento original." kind="pdf"/>
