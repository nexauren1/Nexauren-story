---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Minificador CSS — Ferramenta online | Nexauren Story" description="Remove comentários e espaços CSS.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/developer">Programador</a><span>›</span><span aria-current="page">Minificador CSS</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">CSS</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Minificador CSS</h1><p>Remove comentários e espaços CSS.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="css-minifier" title="Minificador CSS" kind="tool" href="/tools/css-minifier"/></div>
  </header>
  <UniversalTool client:load toolId="css-minifier" name="Minificador CSS" category="developer" description="Remove comentários e espaços CSS." kind="developer"/>
  <TrackActivity client:load activityId="css-minifier" activityTitle="Usou Minificador CSS"/>
</main><SiteFooter/></div>
</SiteLayout>
