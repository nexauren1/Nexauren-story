---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TextTools from "../../components/TextTools";
import TrackActivity from "../../components/TrackActivity";
---
<SiteLayout title="Caixa de ferramentas de texto — Nexauren" description="Conta palavras, limpa espaços, altera maiúsculas e organiza linhas num único painel de texto.">
<div class="site-shell"><SiteHeader/><main class="tool-page">
  <div class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/text">Texto</a><span>›</span><span>Caixa de texto</span></div>
  <header class="tool-page-header"><div class="tool-title"><h1>Caixa de ferramentas de texto</h1><p>Estatísticas em tempo real e sete operações práticas para limpar e organizar conteúdo.</p></div><span class="tool-state"><i/> PRONTO A UTILIZAR</span></header>
  <TextTools client:load/><TrackActivity client:load activityId="tool-text-toolbox" activityTitle="Usou a caixa de ferramentas de texto"/>
  <p class="tool-footer-note">Nexauren · Text Toolbox · <a href="/privacy">Privacidade</a></p>
</main><SiteFooter/></div></SiteLayout>