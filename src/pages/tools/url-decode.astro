---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Descodificar URL — Ferramenta online | Nexauren" description="Descodifica sequências percent-encoded e recupera o texto original de uma URL.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/text">Texto</a><span>›</span><span>Descodificar URL</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / TEXT LAB</span><h1>Descodificar URL</h1><p>Descodifica sequências percent-encoded e recupera o texto original de uma URL.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="url-decode" title="Descodificar URL" kind="tool" href="/tools/url-decode"/></div></header>
<UniversalTool client:load toolId="url-decode" name="Descodificar URL" category="text" description="Descodifica sequências percent-encoded e recupera o texto original de uma URL." kind="text"/>
<TrackActivity client:load activityId="url-decode" activityTitle="Usou Descodificar URL"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Copiar ou guardar resultado</span></section>
</main><SiteFooter/></div></SiteLayout>