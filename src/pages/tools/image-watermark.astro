---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ImageWatermark from "../../components/ImageWatermark";
import TrackActivity from "../../components/TrackActivity";
import FavoriteButton from "../../components/FavoriteButton";
---
<SiteLayout title="Marca de água em imagem — Nexauren" description="Adiciona marcas de água de texto às tuas imagens, escolhe posição, cor e opacidade e exporta em PNG, JPG ou WebP.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/image">Imagem</a><span>›</span><span>Marca de água</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / IMAGE LAB</span><h1>Marca de água em imagem</h1><p>Protege e identifica as tuas imagens com texto personalizado, posição, cor e opacidade ajustáveis.</p></div><div class="tool-header-actions"><span class="tool-state"><i/> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="image-watermark" title="Marca de água em imagem" kind="tool" href="/tools/image-watermark"/></div></header>
<ImageWatermark client:load/><TrackActivity client:load activityId="image-watermark" activityTitle="Usou Marca de água em imagem"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ 9 posições</span><span>↗ PNG · JPG · WebP</span></section>
</main><SiteFooter/></div></SiteLayout>