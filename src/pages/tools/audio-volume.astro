---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Ajustar volume do áudio — Ferramenta online | Nexauren" description="Aumenta ou reduz o ganho do áudio e exporta uma versão WAV com o nível ajustado.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/audio">Áudio</a><span>›</span><span>Ajustar volume do áudio</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / AUDIO LAB</span><h1>Ajustar volume do áudio</h1><p>Aumenta ou reduz o ganho do áudio e exporta uma versão WAV com o nível ajustado.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="audio-volume" title="Ajustar volume do áudio" kind="tool" href="/tools/audio-volume"/></div></header>
<UniversalTool client:load toolId="audio-volume" name="Ajustar volume do áudio" category="audio" description="Aumenta ou reduz o ganho do áudio e exporta uma versão WAV com o nível ajustado." kind="audio"/>
<TrackActivity client:load activityId="audio-volume" activityTitle="Usou Ajustar volume do áudio"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>