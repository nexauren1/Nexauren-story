---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Espelhar imagem — Ferramenta online | Nexauren" description="Espelha horizontalmente uma imagem e exporta uma cópia transformada.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/image">Imagem</a><span>›</span><span>Espelhar imagem</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / IMAGE LAB</span><h1>Espelhar imagem</h1><p>Espelha horizontalmente uma imagem e exporta uma cópia transformada.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="image-flip" title="Espelhar imagem" kind="tool" href="/tools/image-flip"/></div></header>
<UniversalTool client:load toolId="image-flip" name="Espelhar imagem" category="image" description="Espelha horizontalmente uma imagem e exporta uma cópia transformada." kind="image"/>
<TrackActivity client:load activityId="image-flip" activityTitle="Usou Espelhar imagem"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>