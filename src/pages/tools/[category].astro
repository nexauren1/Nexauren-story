---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
export function getStaticPaths() {
  return [
    { params:{category:"image"}, props:{number:"01",name:"Imagem",title:"Ferramentas de imagem",description:"Redimensiona, comprime, converte e corta imagens diretamente no navegador.",intro:"Controlo de dimensões, formato e composição.",icon:"▧",tools:[
      {name:"Image Studio",description:"Redimensionar, comprimir e converter JPG, PNG e WebP.",href:"/tools/image-resizer",active:true,label:"Disponível"},
      {name:"Cortar imagem",description:"Define coordenadas de corte e exporta uma nova imagem.",href:"/tools/image-cropper",active:true,label:"Disponível"}
    ]}},
    { params:{category:"pdf"}, props:{number:"02",name:"PDF",title:"Ferramentas PDF",description:"Organiza, otimiza e transforma documentos PDF.",intro:"Operações de documentos num só local.",icon:"PDF",tools:[
      {name:"Otimizar PDF",description:"Reestrutura o documento e mantém as páginas e o conteúdo.",href:"/tools/pdf-compressor",active:true,label:"Disponível"},
      {name:"Juntar PDFs",description:"Combina vários PDFs mantendo a ordem escolhida.",href:"/tools/pdf-merger",active:true,label:"Disponível"},
      {name:"Extrair páginas",description:"Seleciona intervalos e cria um documento separado.",href:"/tools/pdf-splitter",active:true,label:"Disponível"},
      {name:"Rodar PDF",description:"Roda todas as páginas ou uma página específica.",href:"/tools/pdf-rotator",active:true,label:"Disponível"}
    ]}},
    { params:{category:"text"}, props:{number:"03",name:"Texto",title:"Ferramentas de texto",description:"Transforma e organiza texto com operações rápidas.",intro:"Escrita mais limpa e conteúdo melhor organizado.",icon:"Aa",tools:[
      {name:"Caixa de ferramentas de texto",description:"Contagem, maiúsculas, minúsculas, limpeza e organização de linhas.",href:"/tools/text-toolbox",active:true,label:"Disponível"}
    ]}},
    { params:{category:"audio"}, props:{number:"04",name:"Áudio",title:"Ferramentas de áudio",description:"Prepara ficheiros de áudio com operações locais.",intro:"Seleciona excertos e ajusta os níveis do som.",icon:"♫",tools:[
      {name:"Cortar áudio",description:"Seleciona um trecho, ouve e exporta em WAV.",href:"/tools/audio-cutter",active:true,label:"Disponível"},
      {name:"Normalizar volume",description:"Analisa o pico e ajusta o volume de saída.",href:"/tools/audio-normalizer",active:true,label:"Disponível"}
    ]}}
  ];
}
const {number,name,title,description,intro,icon,tools}=Astro.props;
---
<SiteLayout title={title+" — Nexauren"} description={description}><div class="site-shell"><SiteHeader/><main class="simple-page category-landing">
  <div class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><span>{name}</span></div>
  <div class="eyebrow"><span class="eyebrow-line"></span> {number} / ÁREA ESPECIALIZADA</div>
  <h1>{title}.<br/><span>{intro}</span></h1><p class="simple-lead">{description}</p>
  <div class="category-tool-grid">{tools.map((tool)=> <article class:list={["category-tool-card",{"is-available":tool.active}]}><div class="category-tool-top"><span class="category-tool-icon">{icon}</span><span class:list={["tool-availability",{"is-ready":tool.active}]}>{tool.label}</span></div><h2>{tool.name}</h2><p>{tool.description}</p><a href={tool.href}>Abrir ferramenta <b>↗</b></a></article>)}</div>
  <a class="back-to-tools" href="/tools">← Todas as áreas</a>
</main><SiteFooter/></div></SiteLayout>