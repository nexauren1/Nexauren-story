---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import catalog from "../../data/activeTools.json";
export function getStaticPaths() {
  return catalog.categories.map(category => ({
    params: { category: category.id },
    props: { category, tools: catalog.tools.filter(tool => tool.category === category.id) }
  }));
}
const { category, tools } = Astro.props;
---
<SiteLayout title={category.name+" — Ferramentas online gratuitas | Nexauren Story"} description={category.description+" Explora "+tools.length+" ferramentas online gratuitas desta categoria na Nexauren Story."}>
<div class="site-shell">
  <SiteHeader />
  <main class="ns-main ns-category-page">
    <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><span aria-current="page">{category.name}</span></nav>
    <header class="ns-page-hero ns-category-hero">
      <div><span class="ns-eyebrow"><i>{category.icon}</i> CATEGORIA / {category.id.toUpperCase()}</span><h1>Ferramentas de <em>{category.name.toLowerCase()}.</em></h1><p>{category.description} Escolhe uma ferramenta para começares a trabalhar diretamente no navegador.</p><div class="ns-category-meta"><b>{tools.length}</b> ferramentas disponíveis <span>·</span> <a href="/tools">Ver todas as ferramentas ↗</a></div></div>
      <div class="ns-category-hero-icon" data-tone={category.tone}>{category.icon}</div>
    </header>
    <div class="ns-results-heading"><div><span class="ns-section-kicker">EXPLORAR CATEGORIA</span><h2>Escolhe a tua ferramenta.</h2></div><span>{tools.length} ferramentas</span></div>
    <section class="ns-tool-grid ns-directory-grid" aria-label={"Ferramentas de "+category.name}>
      {tools.map(tool => <a class="ns-tool-card ns-directory-card" href={tool.path} data-tone={category.tone}>
        <div class="ns-tool-card-top"><span class="ns-tool-icon">{tool.icon}</span><span class="ns-tool-pill">{category.name}</span></div>
        <h2>{tool.name}</h2><p>{tool.description}</p><span class="ns-tool-card-link">Abrir ferramenta <b>↗</b></span>
      </a>)}
    </section>
    <a class="ns-back-link" href="/tools">← Voltar a todas as ferramentas</a>
  </main>
  <SiteFooter />
</div>
</SiteLayout>