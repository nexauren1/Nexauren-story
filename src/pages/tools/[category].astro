---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import catalog from "../../data/activeTools.json";
export function getStaticPaths() {
  return catalog.categories.map((category) => ({
    params: { category: category.id },
    props: { category, tools: catalog.tools.filter((tool) => tool.category === category.id) }
  }));
}
const { category, tools } = Astro.props;
---
<SiteLayout title={category.name + " — Ferramentas online | Nexauren"} description={category.description + " Explora " + tools.length + " ferramentas disponíveis na Nexauren."}>
<div class="site-shell">
  <SiteHeader />
  <main class="nx-category-page">
    <nav class="nx-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><span aria-current="page">{category.name}</span></nav>
    <header class="nx-page-heading nx-category-heading">
      <span class="nx-overline"><i></i> CATEGORIA / {category.id.toUpperCase()}</span>
      <span class="nx-category-large-icon" data-tone={category.tone}>{category.icon}</span>
      <h1>{category.name}<span>.</span></h1>
      <p>{category.description}</p>
      <div class="nx-catalog-meta"><span><b>{tools.length}</b> ferramentas disponíveis</span><span class="nx-meta-dot"></span><a href="/tools">Ver todas as categorias ↗</a></div>
    </header>
    <section class="nx-category-tools">
      <div class="nx-catalog-results-heading"><div><span class="nx-section-label">FERRAMENTAS DE {category.name.toUpperCase()}</span><h2>Escolhe por onde começar</h2></div><span>{tools.length.toString().padStart(2, "0")} disponíveis</span></div>
      <div class="nx-tool-grid">
        {tools.map((tool) => (
          <a class="nx-tool-card" href={tool.path} data-tone={category.tone}>
            <div class="nx-tool-card-top"><span class="nx-tool-icon">{tool.icon}</span><span class="nx-tool-category">{category.name}</span></div>
            <h3>{tool.name}</h3><p>{tool.description}</p>
            <span class="nx-tool-card-action">Abrir ferramenta <b>↗</b></span>
          </a>
        ))}
      </div>
    </section>
    <a class="nx-back-link" href="/tools">← Voltar ao catálogo completo</a>
  </main>
  <SiteFooter />
</div>
</SiteLayout>