---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Validador JSON — Ferramenta online | Nexauren Story" description="Verifica a sintaxe JSON e aponta erros.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/developer">Programador</a><span>›</span><span aria-current="page">Validador JSON</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">JSON</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Validador JSON</h1><p>Verifica a sintaxe JSON e aponta erros.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="json-validator" title="Validador JSON" kind="tool" href="/tools/json-validator"/></div>
  </header>
  <UniversalTool client:load toolId="json-validator" name="Validador JSON" category="developer" description="Verifica a sintaxe JSON e aponta erros." kind="developer"/>
  <TrackActivity client:load activityId="json-validator" activityTitle="Usou Validador JSON"/>
</main><SiteFooter/></div>
</SiteLayout>
