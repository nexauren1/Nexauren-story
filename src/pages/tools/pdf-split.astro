---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Extrair páginas por intervalo — Ferramenta online | Nexauren" description="Extrai páginas específicas ou vários intervalos e guarda-os num novo documento PDF.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/pdf">PDF</a><span>›</span><span>Extrair páginas por intervalo</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / PDF LAB</span><h1>Extrair páginas por intervalo</h1><p>Extrai páginas específicas ou vários intervalos e guarda-os num novo documento PDF.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="pdf-split" title="Extrair páginas por intervalo" kind="tool" href="/tools/pdf-split"/></div></header>
<UniversalTool client:load toolId="pdf-split" name="Extrair páginas por intervalo" category="pdf" description="Extrai páginas específicas ou vários intervalos e guarda-os num novo documento PDF." kind="pdf"/>
<TrackActivity client:load activityId="pdf-split" activityTitle="Usou Extrair páginas por intervalo"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>