---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Dia da semana — Ferramenta online | Nexauren Story" description="Descobre o dia da semana de uma data.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/dates">Data e tempo</a><span>›</span><span aria-current="page">Dia da semana</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">▦</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Dia da semana</h1><p>Descobre o dia da semana de uma data.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="weekday-finder" title="Dia da semana" kind="tool" href="/tools/weekday-finder"/></div>
  </header>
  <UniversalTool client:load toolId="weekday-finder" name="Dia da semana" category="dates" description="Descobre o dia da semana de uma data." kind="dates"/>
  <TrackActivity client:load activityId="weekday-finder" activityTitle="Usou Dia da semana"/>
</main><SiteFooter/></div>
</SiteLayout>
