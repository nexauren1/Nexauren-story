---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Contar páginas PDF — Ferramenta online | Nexauren" description="Conta páginas e consulta o tamanho do ficheiro, título e autor do documento PDF.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/pdf">PDF</a><span>›</span><span>Contar páginas PDF</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / PDF LAB</span><h1>Contar páginas PDF</h1><p>Conta páginas e consulta o tamanho do ficheiro, título e autor do documento PDF.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="pdf-page-count" title="Contar páginas PDF" kind="tool" href="/tools/pdf-page-count"/></div></header>
<UniversalTool client:load toolId="pdf-page-count" name="Contar páginas PDF" category="pdf" description="Conta páginas e consulta o tamanho do ficheiro, título e autor do documento PDF." kind="pdf"/>
<TrackActivity client:load activityId="pdf-page-count" activityTitle="Usou Contar páginas PDF"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>