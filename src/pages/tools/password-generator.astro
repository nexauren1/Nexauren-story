---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Gerador de palavras-passe — Ferramenta online gratuita | Nexauren Story" description="Gera palavras-passe aleatórias no navegador, com controlo do comprimento e sem enviar dados para um servidor.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/text">Texto</a><span>›</span><span>Gerador de palavras-passe</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN / LABORATÓRIO DE TEXTO</span><h1>Gerador de palavras-passe</h1><p>Gera palavras-passe aleatórias no navegador, com controlo do comprimento e sem enviar dados para um servidor.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="password-generator" title="Gerador de palavras-passe" kind="tool" href="/tools/password-generator"/></div></header>
<UniversalTool client:load toolId="password-generator" name="Gerador de palavras-passe" category="text" description="Gera palavras-passe aleatórias no navegador, com controlo do comprimento e sem enviar dados para um servidor." kind="generators"/>
