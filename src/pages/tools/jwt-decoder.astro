---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Descodificador JWT — Ferramenta online | Nexauren Story" description="Lê o cabeçalho e payload de um JWT.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/developer">Programador</a><span>›</span><span aria-current="page">Descodificador JWT</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">JWT</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Descodificador JWT</h1><p>Lê o cabeçalho e payload de um JWT.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="jwt-decoder" title="Descodificador JWT" kind="tool" href="/tools/jwt-decoder"/></div>
  </header>
  <UniversalTool client:load toolId="jwt-decoder" name="Descodificador JWT" category="developer" description="Lê o cabeçalho e payload de um JWT." kind="developer"/>
  <TrackActivity client:load activityId="jwt-decoder" activityTitle="Usou Descodificador JWT"/>
</main><SiteFooter/></div>
</SiteLayout>
