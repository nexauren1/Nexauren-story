---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ImageRotate from "../../components/ImageRotate";
import TrackActivity from "../../components/TrackActivity";
import FavoriteButton from "../../components/FavoriteButton";
---
<SiteLayout title="Rodar e espelhar imagem — Nexauren" description="Roda imagens 90 ou 180 graus, espelha horizontalmente ou verticalmente e exporta PNG, JPG ou WebP.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/image">Imagem</a><span>›</span><span>Rodar e espelhar</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / IMAGE LAB</span><h1>Rodar e espelhar imagem</h1><p>Corrige a orientação, roda em ângulos precisos e espelha a imagem com pré-visualização imediata.</p></div><div class="tool-header-actions"><span class="tool-state"><i/> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="image-rotate" title="Rodar e espelhar imagem" kind="tool" href="/tools/image-rotate"/></div></header>
<ImageRotate client:load/><TrackActivity client:load activityId="image-rotate" activityTitle="Usou Rodar e espelhar imagem"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Rotação e espelhamento</span><span>↗ PNG · JPG · WebP</span></section>
</main><SiteFooter/></div></SiteLayout>