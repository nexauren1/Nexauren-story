---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Contador de caracteres — Ferramenta online | Nexauren Story" description="Conta caracteres com e sem espaços.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/text">Texto</a><span>›</span><span aria-current="page">Contador de caracteres</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">123</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Contador de caracteres</h1><p>Conta caracteres com e sem espaços.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="text-character-counter" title="Contador de caracteres" kind="tool" href="/tools/text-character-counter"/></div>
  </header>
  <UniversalTool client:load toolId="text-character-counter" name="Contador de caracteres" category="text" description="Conta caracteres com e sem espaços." kind="text"/>
  <TrackActivity client:load activityId="text-character-counter" activityTitle="Usou Contador de caracteres"/>
</main><SiteFooter/></div>
</SiteLayout>
