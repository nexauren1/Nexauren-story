---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TrackActivity from "../../components/TrackActivity";
import FavoriteButton from "../../components/FavoriteButton";
import ImageResizer from "../../components/ImageResizer";
---
<SiteLayout title="Compressor e redimensionador de imagens — JPG, PNG e WebP | Nexauren Story" description="Comprima e redimensione imagens JPG, PNG e WebP online. Ajuste dimensões, proporção, qualidade e formato de exportação diretamente no navegador.">
<div class="site-shell">
  <SiteHeader />
  <main class="ns-main ns-tool-page">
    <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/image">Imagem</a><span>›</span><span aria-current="page">Compressor de imagens</span></nav>
    <header class="ns-tool-heading">
      <span class="ns-tool-heading-icon">▧</span>
      <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN IMAGE LAB / FERRAMENTA ONLINE</span><h1>Compressor e redimensionador de imagens</h1><p>Reduz o tamanho das imagens e ajusta as dimensões sem sair do navegador.</p></div>
      <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="image-resizer" title="Compressor e redimensionador de imagens" kind="tool" href="/tools/image-resizer"/></div>
    </header>
    <section class="ns-tool-benefits"><span>✓ Processamento local</span><span>✓ JPG · PNG · WebP</span><span>✓ Controlo de qualidade</span><span>✓ Sem instalação</span></section>
    <ImageResizer client:load />
    <TrackActivity client:load activityId="image-resizer" activityTitle="Usou o compressor e redimensionador de imagens"/>
  </main>
  <SiteFooter />
</div>
</SiteLayout>