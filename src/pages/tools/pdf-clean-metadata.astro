---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Limpar metadados PDF — Ferramenta online | Nexauren" description="Remove metadados básicos como autor, título, assunto, criador e palavras-chave.">
<div class="site-shell"><SiteHeader/><main class="tool-page tool-page-premium">
<nav class="tool-breadcrumb"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/pdf">PDF</a><span>›</span><span>Limpar metadados PDF</span></nav>
<header class="tool-page-header"><div class="tool-title"><span class="section-kicker">NEXAUREN ENGINE / PDF LAB</span><h1>Limpar metadados PDF</h1><p>Remove metadados básicos como autor, título, assunto, criador e palavras-chave.</p></div><div class="tool-header-actions"><span class="tool-state"><i></i> MOTOR DISPONÍVEL</span><FavoriteButton client:load itemId="pdf-clean-metadata" title="Limpar metadados PDF" kind="tool" href="/tools/pdf-clean-metadata"/></div></header>
<UniversalTool client:load toolId="pdf-clean-metadata" name="Limpar metadados PDF" category="pdf" description="Remove metadados básicos como autor, título, assunto, criador e palavras-chave." kind="pdf"/>
<TrackActivity client:load activityId="pdf-clean-metadata" activityTitle="Usou Limpar metadados PDF"/>
<section class="tool-trust-strip"><span>◈ Processamento local</span><span>⌁ Sem instalação</span><span>↗ Resultado descarregável</span></section>
</main><SiteFooter/></div></SiteLayout>