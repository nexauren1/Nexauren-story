---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FavoriteButton from "../../components/FavoriteButton";
import TrackActivity from "../../components/TrackActivity";
import UniversalTool from "../../components/UniversalTool";
---
<SiteLayout title="Testador RegEx — Ferramenta online | Nexauren Story" description="Testa uma expressão regular contra texto.">
<div class="site-shell"><SiteHeader/>
<main class="ns-main ns-tool-page">
  <nav class="ns-breadcrumb" aria-label="Trilho de navegação"><a href="/">Início</a><span>›</span><a href="/tools">Ferramentas</a><span>›</span><a href="/tools/developer">Programador</a><span>›</span><span aria-current="page">Testador RegEx</span></nav>
  <header class="ns-tool-heading">
    <span class="ns-tool-heading-icon">.*</span>
    <div class="ns-tool-heading-copy"><span class="ns-section-kicker">NEXAUREN / FERRAMENTA ONLINE</span><h1>Testador RegEx</h1><p>Testa uma expressão regular contra texto.</p></div>
    <div class="ns-tool-heading-actions"><span class="ns-live-pill"><i></i> MOTOR LOCAL</span><FavoriteButton client:load itemId="regex-tester" title="Testador RegEx" kind="tool" href="/tools/regex-tester"/></div>
  </header>
  <UniversalTool client:load toolId="regex-tester" name="Testador RegEx" category="developer" description="Testa uma expressão regular contra texto." kind="developer"/>
  <TrackActivity client:load activityId="regex-tester" activityTitle="Usou Testador RegEx"/>
</main><SiteFooter/></div>
</SiteLayout>
