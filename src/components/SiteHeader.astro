---
import AccountLink from "./AccountLink";
---
<header class="site-header site-header-premium">
  <a class="site-brand" href="/" aria-label="Nexauren — página inicial">
    <svg class="brand-mark" viewBox="0 0 44 44" role="img" aria-label="Nexauren"><defs><linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#19b5ae"/><stop offset="1" stop-color="#416bd9"/></linearGradient></defs><path d="M22 2.5 41 13.3v17.4L22 41.5 3 30.7V13.3z" fill="url(#brand-gradient)"/><path d="M12 25.5 23 11l9 21H12l11-14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Nexauren</span><small>TOOLS & DIGITAL</small>
  </a>
  <nav class="desktop-nav" aria-label="Navegação principal">
    <details class="nav-dropdown"><summary data-i18n="nav.tools">Ferramentas <span>⌄</span></summary><div class="nav-dropdown-panel">
      <a href="/tools">Todas as 100 ferramentas</a><a href="/tools/image">Imagem</a><a href="/tools/pdf">PDF</a><a href="/tools/text">Texto</a><a href="/tools/audio">Áudio</a><a href="/tools/converters">Conversores</a><a href="/tools/generators">Geradores</a><a href="/tools/calculators">Calculadoras</a><a href="/tools/developer">Programador</a><a href="/tools/colors">Cores e design</a><a href="/tools/dates">Data e tempo</a>
    </div></details>
    <a href="/highlights" data-i18n="nav.highlights">Destaques</a><a href="/apps" data-i18n="nav.apps">Aplicações</a><a href="/blog" data-i18n="nav.blog">Blog</a>
  </nav>
  <div class="header-actions">
    <label class="language-control"><span aria-hidden="true">◎</span><select data-language-select aria-label="Idioma"><option value="pt">PT</option><option value="en">EN</option><option value="es">ES</option><option value="fr">FR</option></select></label>
    <AccountLink client:load/>
    <button class="icon-button mobile-menu-toggle" type="button" data-menu-toggle aria-label="Abrir menu" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </div>
</header>
<nav class="mobile-nav mobile-nav-premium" data-mobile-menu aria-label="Navegação móvel">
  <a href="/tools" data-i18n="nav.tools">Ferramentas</a><a href="/highlights" data-i18n="nav.highlights">Destaques</a><a href="/apps" data-i18n="nav.apps">Aplicações</a><a href="/blog" data-i18n="nav.blog">Blog</a><a href="/account" data-i18n="nav.account">Minha conta</a>
</nav>