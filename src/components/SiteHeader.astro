---
import AccountLink from "./AccountLink";
---
<header class="nx-site-header">
  <a class="nx-brand" href="/" aria-label="Nexauren — página inicial">
    <svg viewBox="0 0 44 44" role="img" aria-label="Nexauren">
      <defs><linearGradient id="nx-brand-gradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#28c4b2"/><stop offset="1" stop-color="#4774f5"/></linearGradient></defs>
      <path d="M22 2.5 41 13.3v17.4L22 41.5 3 30.7V13.3z" fill="url(#nx-brand-gradient)"/>
      <path d="M13 30V14l18 16V14" fill="none" stroke="#fff" stroke-width="3.1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>Nexauren<small>TOOLS & DIGITAL</small></span>
  </a>
  <nav class="nx-desktop-nav" aria-label="Navegação principal">
    <a href="/tools" data-i18n="nav.tools">Ferramentas</a>
    <a href="/highlights" data-i18n="nav.highlights">Destaques</a>
    <a href="/apps" data-i18n="nav.apps">Aplicações</a>
    <a href="/blog" data-i18n="nav.blog">Blog</a>
  </nav>
  <div class="nx-header-actions">
    <AccountLink client:load />
    <button class="nx-menu-toggle" type="button" data-menu-toggle aria-label="Abrir menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>
<nav class="nx-mobile-nav" data-mobile-menu aria-label="Navegação móvel">
  <a href="/tools" data-i18n="nav.tools">Ferramentas</a>
  <a href="/highlights" data-i18n="nav.highlights">Destaques</a>
  <a href="/apps" data-i18n="nav.apps">Aplicações</a>
  <a href="/blog" data-i18n="nav.blog">Blog</a>
  <a href="/account" data-i18n="nav.account">Minha conta</a>
</nav>