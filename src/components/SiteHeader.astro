---
const current = Astro.url.pathname;
---
<header class="ns-header">
  <div class="ns-header-inner">
    <a class="ns-brand" href="/" aria-label="Nexauren Story — página inicial">
      <span class="ns-brand-mark" aria-hidden="true">N</span>
      <span class="ns-brand-name">Nexauren <b>Story</b></span>
    </a>
    <nav class="ns-desktop-nav" aria-label="Navegação principal">
      <a href="/" class:list={{active:current==="/"}}>Início</a>
      <a href="/tools" class:list={{active:current.startsWith("/tools")}}>Ferramentas</a>
      <a href="/blog" class:list={{active:current.startsWith("/blog")}}>Blog</a>
      <a href="/about" class:list={{active:current==="/about"}}>Sobre</a>
      <a href="/contact" class:list={{active:current==="/contact"}}>Contacto</a>
    </nav>
    <div class="ns-header-actions">
      <form class="ns-header-search" action="/tools" method="get" role="search">
        <span aria-hidden="true">⌕</span>
        <input type="search" name="q" placeholder="Pesquisar ferramentas..." aria-label="Pesquisar ferramentas" />
      </form>
      <button class="ns-icon-button" type="button" data-theme-toggle aria-label="Ativar modo claro" aria-pressed="true"><span data-theme-icon>☼</span></button>
      <label class="ns-language-select" title="Idioma do site">
        <span class="sr-only">Idioma do site</span>
        <select data-language-select aria-label="Idioma do site">
          <option value="en">EN</option>
          <option value="pt">PT</option>
        </select>
      </label>
      <a class="ns-account-link" href="/account"><span aria-hidden="true">◉</span><span>Conta</span></a>
      <button class="ns-menu-toggle" type="button" data-menu-toggle aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<nav class="ns-mobile-nav" data-mobile-menu aria-label="Navegação móvel">
  <a href="/">Início</a>
  <a href="/tools">Ferramentas</a>
  <a href="/blog">Blog</a>
  <a href="/about">Sobre</a>
  <a href="/contact">Contacto</a>
  <a href="/account">A minha conta</a>
  <div class="ns-mobile-controls">
    <label>Idioma <select data-language-select aria-label="Idioma do site"><option value="en">English</option><option value="pt">Português</option></select></label>
    <button class="ns-icon-button" type="button" data-theme-toggle aria-label="Ativar modo claro"><span data-theme-icon>☼</span> Tema</button>
  </div>
</nav>